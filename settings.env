# Defaults for this machine. Everything here can be overridden, without touching
# a tracked file, by creating settings.local.env (gitignored) beside it.

# --- identity --------------------------------------------------------------
# Empty means "keep whatever the image was given". Raspberry Pi Imager already
# asks for a hostname, and silently renaming the host afterwards would break
# ssh <name>.local for no reason. Set this only to override that choice.
PI_HOSTNAME="${PI_HOSTNAME-}"
PI_TIMEZONE="${PI_TIMEZONE:-America/Los_Angeles}"
PI_LOCALE="${PI_LOCALE:-en_US.UTF-8}"
PI_KEYBOARD_LAYOUT="${PI_KEYBOARD_LAYOUT:-us}"

# --- git -------------------------------------------------------------------
# Where repos live. Bind-mounted from the SSD by 25-ssd-state.sh, so clones
# survive a reflash. The 'github' shell function jumps here.
GITHUB_DIR="${GITHUB_DIR:-$TARGET_HOME/GitHub}"
# Empty here on purpose: identity belongs in settings.local.env, which is
# gitignored. Keeping it out of the tracked file means this repo carries nobody's
# details, and a fork does not inherit someone else's name on its commits.
GIT_USER_NAME="${GIT_USER_NAME-}"
GIT_USER_EMAIL="${GIT_USER_EMAIL-}"

# --- network ---------------------------------------------------------------
# Prefer setting Wi-Fi in Raspberry Pi Imager. These are the fallback for an
# image that came up with no network; put them in settings.local.env, not here.
WIFI_SSID="${WIFI_SSID:-}"
WIFI_PSK="${WIFI_PSK:-}"
# Stop the run when there is no internet, rather than failing later inside apt.
NET_REQUIRED="${NET_REQUIRED:-1}"

# --- packages --------------------------------------------------------------
# Installed by 10-base.sh on every image.
BASE_PACKAGES="${BASE_PACKAGES:-git curl wget ca-certificates rsync htop tmux \
	vim jq unzip build-essential python3-venv python3-pip ripgrep}"

# Installed by 40-dev.sh. Optional extras are skipped when unavailable.
DEV_PACKAGES="${DEV_PACKAGES:-shellcheck neovim bat fd-find}"

# --- optional components (1 to enable) -------------------------------------
INSTALL_UV="${INSTALL_UV:-1}"        # Astral uv, for Python
INSTALL_NODE="${INSTALL_NODE:-0}"    # Node via nvm
INSTALL_DOCKER="${INSTALL_DOCKER:-0}"
NODE_VERSION="${NODE_VERSION:-lts/*}"

# --- apps ------------------------------------------------------------------
# Installed by 60-apps.sh. One name per installer in apps/. Order matters:
# open-webui expects ollama to already be there.
APPS="${APPS-ollama gh opencode open-webui}"

OPEN_WEBUI_PORT="${OPEN_WEBUI_PORT:-8080}"


# --- local agent (bin/pi5-agent) -------------------------------------------
# Turns the local model plus the gh CLI into something that can read issues and
# the checkout. No MCP, no cloud. Writes stay off unless asked for per-run.
AGENT_MAX_TURNS="${AGENT_MAX_TURNS:-8}"
# Tool output is truncated to this many characters so one long issue body cannot
# consume the whole context window.
AGENT_MAX_TOOL_CHARS="${AGENT_MAX_TOOL_CHARS:-4000}"
# Reasoning models narrate before answering. That narration is stripped from the
# display and from the conversation history - on an 8K context it crowds out the
# tool results the model actually needs. Set to 1 to keep it, for debugging.
AGENT_SHOW_THINKING="${AGENT_SHOW_THINKING:-0}"
# Paths the agent refuses to write when working on THIS repo. Empty by default:
# its work lands on a branch as a draft PR, and reviewing that is the guard.
# Set it - e.g. "bin/,lib/,scripts/,apps/,Makefile" - if you would rather it
# never touched its own executable code at all.
AGENT_PROTECTED_PATHS="${AGENT_PROTECTED_PATHS-}"
# How the model is asked to call tools:
#   auto   try native tool_calls once, fall back to the text protocol
#   native OpenAI-style tool_calls only
#   text   a TOOL:/ARGS: format the model writes and the agent parses
# Native calling needs the runtime to parse the model's own format, which lags
# model releases. The text protocol needs nothing but a model that can follow
# instructions, so it works where native does not.
AGENT_TOOL_MODE="${AGENT_TOOL_MODE:-auto}"

# Label-driven queue: 'make queue' works every open issue carrying AGENT_LABEL,
# then relabels it so a rerun does not redo the same work.
# A state machine, not a category: the prefix groups them in GitHub's label
# dropdown, and the names stay true if this queue ever runs somewhere else.
# 'make labels' creates them.
AGENT_LABEL="${AGENT_LABEL:-agent:queued}"
# Unattended polling (make queue-timer). Off by default and deliberately not
# implied by anything else: it opens pull requests while you are not watching.
QUEUE_AUTO="${QUEUE_AUTO:-0}"
QUEUE_INTERVAL="${QUEUE_INTERVAL:-15min}"
# Comma-separated repo names under GITHUB_DIR. Empty means every checkout there.
QUEUE_REPOS="${QUEUE_REPOS:-}"
# 1 = search GitHub for labelled issues across your repos and clone any that are
# not on the Pi yet. Without it, an issue labelled in an uncloned repo is simply
# never seen. QUEUE_REPOS still applies, so discovery finds repos rather than
# widening scope.
QUEUE_DISCOVER="${QUEUE_DISCOVER:-0}"
# Whose repos to search. Empty means the authenticated gh user.
QUEUE_OWNER="${QUEUE_OWNER:-}"
# Repo topic that opts a repository in to discovery. Add the topic on GitHub to
# include a repo, remove it to exclude one - no change needed on the Pi. Empty
# means every repo the owner has, which is broader than you probably want left
# running unattended.
QUEUE_TOPIC="${QUEUE_TOPIC-pi-agent}"
AGENT_LABEL_DONE="${AGENT_LABEL_DONE:-agent:done}"
AGENT_LABEL_FAILED="${AGENT_LABEL_FAILED:-agent:failed}"
# Add this label alongside agent:queued to hand the issue to opencode instead of
# the built-in loop. Same model, but opencode edits by patch where write_file
# here rewrites whole files - which is what makes larger files workable on an
# 8K context.
AGENT_LABEL_OPENCODE="${AGENT_LABEL_OPENCODE:-agent:opencode}"
# When the built-in loop opens no PR, try opencode before marking the issue
# failed. Not a retry of the same approach - opencode edits by patch where the
# built-in loop rewrites whole files, so it fails differently. Set to 0 if you
# would rather not spend a second slow attempt on this hardware.
AGENT_ESCALATE="${AGENT_ESCALATE:-1}"

# --- Ollama ------------------------------------------------------------------
# The only model server. LM Studio was dropped: its installer would not run on a
# Lite image, and one runner for one job beats two.
#
# Hermes 3 is trained for function calling and Ollama's parser for its
# <tool_call> format is well established, so pi5-agent is more likely to work
# out of the box here than with a newer model whose format support is fresher.
#   hermes3:3b  2.0 GB, comfortable on 8 GB
#   hermes3:8b  4.7 GB, fits but slow
# qwen3.5:4b-q4_K_M is the coding default - about 2.5 GB, and Qwen3.5 is built
# for agentic coding, which is what the issue queue asks of it.
# hermes3:3b is the fallback if tool calling misbehaves: smaller, and Ollama has
# parsed the Hermes <tool_call> format for years.
OLLAMA_MODEL="${OLLAMA_MODEL:-qwen3.5:4b-q4_K_M}"
OLLAMA_PULL="${OLLAMA_PULL:-}"
OLLAMA_HOST="${OLLAMA_HOST:-127.0.0.1:11434}"
OLLAMA_MODELS_DIR="${OLLAMA_MODELS_DIR:-}"
# Context window the server allocates, in tokens. Ollama defaults to 4096 no
# matter what the model supports, and the OpenAI-compatible endpoint cannot
# override it per request, so it is set on the service. The limit is RAM: the KV
# cache is roughly 140 KB per token for a 4B model, so 8192 costs about 1.1 GB
# beside 2.5 GB of weights. 16384 fits an 8 GB Pi; 32768 does not leave room for
# the OS. Raise it and watch `free -h` and tok/s together.
OLLAMA_CONTEXT_LENGTH="${OLLAMA_CONTEXT_LENGTH:-8192}"

# --- Telegram bridge (apps/telegram.sh) -------------------------------------
# Message the Pi from your phone. Put the real values in settings.local.env,
# which is gitignored - a bot token is a URL anyone can post to.
TELEGRAM_TOKEN="${TELEGRAM_TOKEN:-}"
# Comma-separated chat ids. REQUIRED: without it the bridge refuses to start,
# because anyone who found the bot could otherwise drive it. @userinfobot on
# Telegram tells you yours.
TELEGRAM_ALLOWED_IDS="${TELEGRAM_ALLOWED_IDS:-}"
# 1 lets /work actually open draft PRs. Off by default: a phone message becomes
# a code change. With it off, /work reports what it would have done.
TELEGRAM_ALLOW_WRITE="${TELEGRAM_ALLOW_WRITE:-0}"
# Optional: comma-separated repo names the bot may touch. Empty means any git
# checkout under GITHUB_DIR. Either way a message cannot name an arbitrary path.
TELEGRAM_REPOS="${TELEGRAM_REPOS:-}"
# Optional second lock: every message must start with this or the bot answers
# "I don't know you". Checked after the allowlist, so it is redundant against a
# stranger and useful only if your own account or unlocked phone is used by
# someone else. Not a strong secret - it sits in plaintext chat history.
# Case-insensitive, since a phone capitalises the first word of a message.
# Short is fine - you type it before every message. e.g. TELEGRAM_PASSPHRASE=Doom
TELEGRAM_PASSPHRASE="${TELEGRAM_PASSPHRASE:-}"

# --- storage ---------------------------------------------------------------
# Where the SSD on the HAT gets mounted. Left empty to skip mounting entirely.
SSD_MOUNT_POINT="${SSD_MOUNT_POINT-/mnt/ssd}"
SSD_MOUNT_OPTS="${SSD_MOUNT_OPTS:-defaults,noatime,nofail,x-systemd.device-timeout=10}"

# --- persistent state on the SSD -------------------------------------------
# Keeps the slow-to-rebuild things off the USB boot drive so a reflash does not
# take them with it. Applied by 25-ssd-state.sh.
PERSIST_ON_SSD="${PERSIST_ON_SSD:-1}"
# agent-data is reserved, not used by anything here: somewhere on the SSD for an
# agent's accumulated notes or memory to live, so it survives a reflash if you
# build that later. Provisioning the space is this repo's job; deciding what
# goes in it is not.
SSD_STATE_DIRS="${SSD_STATE_DIRS:-docker ollama GitHub projects ssh agent-data}"
# Space-separated "<dir under SSD_MOUNT_POINT>:<absolute destination>" pairs.
# Deliberately selective - bind-mounting all of /home would carry stale dotfiles
# across an OS change.
SSD_BIND_MOUNTS="${SSD_BIND_MOUNTS-GitHub:$TARGET_HOME/GitHub projects:$TARGET_HOME/projects ssh:$TARGET_HOME/.ssh}"

# Desired EEPROM boot order, read right-to-left: 4=USB, 6=NVMe, 1=SD, f=restart.
# Only written when 20-storage.sh is run with --fix-boot-order.
BOOT_ORDER_DESIRED="${BOOT_ORDER_DESIRED:-0xf164}"

# zram swap as a percentage of RAM. 0 disables.
ZRAM_PERCENT="${ZRAM_PERCENT:-50}"

# --- hardening -------------------------------------------------------------
SSH_DISABLE_PASSWORDS="${SSH_DISABLE_PASSWORDS:-1}"
ENABLE_UFW="${ENABLE_UFW:-1}"
ENABLE_UNATTENDED_UPGRADES="${ENABLE_UNATTENDED_UPGRADES:-1}"
