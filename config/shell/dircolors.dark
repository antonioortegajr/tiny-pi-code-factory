# LS_COLORS tuned for a dark terminal. Debian's default paints directories in a
# blue that is close to unreadable on a near-black background.
TERM *
RESET 0
NORMAL 00
FILE 00
DIR 01;38;5;75
LINK 01;38;5;80
ORPHAN 01;38;5;203
FIFO 40;38;5;180
SOCK 01;38;5;170
DOOR 01;38;5;170
BLK 40;38;5;221;01
CHR 40;38;5;221;01
EXEC 01;38;5;114
SETUID 38;5;220;48;5;52
SETGID 38;5;220;48;5;52
STICKY_OTHER_WRITABLE 38;5;16;48;5;114
OTHER_WRITABLE 38;5;75;48;5;236
STICKY 38;5;16;48;5;75
MISSING 01;38;5;203
.tar 38;5;209
.tgz 38;5;209
.zip 38;5;209
.gz 38;5;209
.xz 38;5;209
.bz2 38;5;209
.deb 38;5;209
.img 38;5;209
.iso 38;5;209
.jpg 38;5;176
.jpeg 38;5;176
.png 38;5;176
.gif 38;5;176
.svg 38;5;176
.mp4 38;5;176
.mkv 38;5;176
.mp3 38;5;168
.flac 38;5;168
.wav 38;5;168
.pdf 38;5;173
.md 38;5;186
.txt 38;5;186
.json 38;5;186
.yaml 38;5;186
.yml 38;5;186
.sh 01;38;5;114
.py 38;5;150
.log 38;5;244
