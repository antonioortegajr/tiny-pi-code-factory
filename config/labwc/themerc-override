# labwc window decoration colours. Overrides individual values of whatever theme
# is active, so this keeps working even if the GTK/openbox theme name changes
# between Raspberry Pi OS releases.
border.width: 1

window.active.border.color: #2e2e2e
window.inactive.border.color: #1a1a1a

window.active.title.bg.color: #1c1c1c
window.inactive.title.bg.color: #151515
window.active.label.text.color: #e6e6e6
window.inactive.label.text.color: #8a8a8a

window.active.button.unpressed.image.color: #e6e6e6
window.inactive.button.unpressed.image.color: #7a7a7a
window.active.button.hover.bg.color: #2e2e2e

menu.items.bg.color: #1c1c1c
menu.items.text.color: #e6e6e6
menu.items.active.bg.color: #c51a4a
menu.items.active.text.color: #ffffff

osd.bg.color: #1c1c1c
osd.border.color: #2e2e2e
osd.label.text.color: #e6e6e6
