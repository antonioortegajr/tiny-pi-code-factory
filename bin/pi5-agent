#!/usr/bin/env python3
"""Work a GitHub issue with the local model. No MCP, no cloud, no pip deps.

Single self-contained file - drop it into any repo's agent harness. It talks to
whichever local model server is running (LM Studio on 1234, Ollama on 11434 -
both speak the OpenAI-compatible shape) and uses the `gh` and `git` CLIs as its
tool layer.

  pi5-agent --selftest              can the model call tools at all?
  pi5-agent --backend ollama ...    talk to Ollama instead of LM Studio
  pi5-agent --queue --allow-write   work every issue labelled pi-agent
  pi5-agent --issue 12              read issue 12, branch, work it, open a draft PR
  pi5-agent "summarise open issues" read-only question

The safety boundary is not "read nothing". It is: never touch the default
branch, never merge, never close. Work lands on an agent/ branch as a draft PR
for a human to review.
"""

import argparse
import json
import os
import re
import subprocess
import sys
import urllib.error
import urllib.request

# Works against either backend: LM Studio on 1234, Ollama on 11434. Both speak
# the OpenAI-compatible shape, so nothing else in here has to care which.
BASE_URL = (os.environ.get("AGENT_BASE_URL")
            or os.environ.get("LMS_BASE_URL")
            or "http://127.0.0.1:1234/v1")
MODEL = os.environ.get("AGENT_MODEL_ID") or os.environ.get("LMS_MODEL_ID", "")
MAX_TURNS = int(os.environ.get("AGENT_MAX_TURNS", "20"))
MAX_TOOL_CHARS = int(os.environ.get("AGENT_MAX_TOOL_CHARS", "4000"))
BRANCH_PREFIX = os.environ.get("AGENT_BRANCH_PREFIX", "agent/")

_tty = sys.stdout.isatty()
DIM, BOLD, RED, GRN, YEL, BLU, RST = (
    ("\033[2m", "\033[1m", "\033[31m", "\033[32m", "\033[33m", "\033[34m", "\033[0m")
    if _tty else ("", "", "", "", "", "", "")
)


def say(m): print(f"{BLU}==>{RST} {m}")
def warn(m): print(f"{YEL}!{RST} {m}", file=sys.stderr)
def die(m, code=1):
    print(f"{RED}{BOLD}ERROR:{RST} {m}", file=sys.stderr)
    sys.exit(code)


def run(cmd, cwd, timeout=120):
    """Fixed argv, never a shell string, so nothing the model emits can be
    interpreted as shell syntax."""
    try:
        p = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, timeout=timeout)
    except FileNotFoundError:
        return 1, f"error: {cmd[0]} is not installed"
    except subprocess.TimeoutExpired:
        return 1, f"error: {cmd[0]} timed out"
    out = (p.stdout or "").strip()
    err = (p.stderr or "").strip()
    if p.returncode != 0:
        return p.returncode, f"error: {err or out or cmd[0] + ' failed'}"
    return 0, out


class Tools:
    def __init__(self, workdir, repo=None, allow_write=False, assume_yes=False):
        self.workdir = os.path.realpath(workdir)
        self.repo = repo
        self.allow_write = allow_write
        self.assume_yes = assume_yes
        self.branch = None      # set once we switch to an agent branch
        self.touched = set()
        self.pr_url = ""        # set when a draft PR is actually opened

    # -- helpers -----------------------------------------------------------

    def _gh(self, *args):
        cmd = ["gh", *args]
        if self.repo and args and args[0] in ("issue", "pr", "repo"):
            cmd += ["--repo", self.repo]
        return run(cmd, self.workdir)[1]

    def _git(self, *args):
        return run(["git", *args], self.workdir)[1]

    def _safe_path(self, path):
        full = os.path.realpath(os.path.join(self.workdir, path))
        if full != self.workdir and not full.startswith(self.workdir + os.sep):
            return None
        if os.sep + ".git" + os.sep in full + os.sep:
            return None          # the model has no business rewriting git internals
        return full

    def _confirm(self, what):
        """Only for things that leave this machine. Local edits on a throwaway
        branch are reviewable and revertible, so they do not prompt."""
        if not self.allow_write:
            return "refused: read-only run. Rerun with --allow-write."
        if self.assume_yes:
            return None
        print(f"\n{YEL}The model wants to:{RST} {what}")
        try:
            ok = input("  Type 'yes' to allow: ").strip() == "yes"
        except EOFError:
            ok = False
        return None if ok else "refused: you declined this action."

    def current_branch(self):
        return self._git("rev-parse", "--abbrev-ref", "HEAD")

    def default_branch(self):
        ref = self._git("symbolic-ref", "refs/remotes/origin/HEAD")
        if ref.startswith("error"):
            return "main"
        return ref.rsplit("/", 1)[-1]

    # -- read --------------------------------------------------------------

    def gh_issue_list(self, state="open", limit=20):
        return self._gh("issue", "list", "--state", str(state), "--limit", str(limit),
                        "--json", "number,title,state,labels,updatedAt")

    def gh_issue_view(self, number):
        return self._gh("issue", "view", str(number),
                        "--json", "number,title,state,body,labels,comments")

    def list_files(self, path="."):
        full = self._safe_path(path)
        if not full:
            return "error: path is outside the working directory"
        if not os.path.isdir(full):
            return f"error: not a directory: {path}"
        names = sorted(n for n in os.listdir(full) if n != ".git")
        return "\n".join(names) or "(empty)"

    def read_file(self, path):
        full = self._safe_path(path)
        if not full:
            return "error: path is outside the working directory"
        if not os.path.isfile(full):
            return f"error: no such file: {path}"
        try:
            with open(full, encoding="utf-8", errors="replace") as fh:
                return fh.read()
        except OSError as exc:
            return f"error: {exc}"

    def search_files(self, pattern, path="."):
        full = self._safe_path(path)
        if not full:
            return "error: path is outside the working directory"
        code, out = run(["git", "grep", "-n", "--", pattern, "--", path], self.workdir)
        if code != 0:
            return "no matches"
        return out

    def git_diff(self):
        out = self._git("diff")
        return out or "(no uncommitted changes)"

    # -- write, on an agent branch only ------------------------------------

    def git_branch(self, name):
        """Always prefixed, always off the default branch. This is the whole
        containment story: nothing the model does lands on main."""
        if not self.allow_write:
            return "refused: read-only run. Rerun with --allow-write."
        slug = re.sub(r"[^a-zA-Z0-9._/-]+", "-", name).strip("-/") or "work"
        if not slug.startswith(BRANCH_PREFIX):
            slug = BRANCH_PREFIX + slug
        out = self._git("switch", "-c", slug)
        if out.startswith("error"):
            out = self._git("switch", slug)
            if out.startswith("error"):
                return out
        self.branch = slug
        return f"now on branch {slug}"

    def write_file(self, path, content):
        if not self.allow_write:
            return "refused: read-only run. Rerun with --allow-write."
        if not self.branch:
            return ("refused: not on an agent branch yet. "
                    "Call git_branch first so the work is reviewable.")
        full = self._safe_path(path)
        if not full:
            return "error: path is outside the working directory"
        try:
            os.makedirs(os.path.dirname(full), exist_ok=True)
            with open(full, "w", encoding="utf-8") as fh:
                fh.write(content)
        except OSError as exc:
            return f"error: {exc}"
        self.touched.add(path)
        print(f"{GRN}  wrote{RST} {path} ({len(content)} bytes)")
        return f"wrote {path}"

    def git_commit(self, message):
        if not self.allow_write:
            return "refused: read-only run. Rerun with --allow-write."
        if not self.branch:
            return "refused: not on an agent branch."
        if self.branch == self.default_branch():
            return "refused: will not commit to the default branch."
        self._git("add", "-A")
        out = self._git("commit", "-m", message)
        return out if not out.startswith("error") else out

    # -- outward facing: these prompt ---------------------------------------

    def gh_pr_create(self, title, body):
        refusal = self._confirm(f"open a DRAFT pull request titled {title!r}")
        if refusal:
            return refusal
        if not self.branch:
            return "refused: no agent branch to open a PR from."
        push = self._git("push", "-u", "origin", self.branch)
        if push.startswith("error"):
            return push
        # Draft, always. A human opens it for review; nothing auto-merges.
        out = self._gh("pr", "create", "--draft", "--title", title, "--body", body,
                       "--head", self.branch)
        if not out.startswith("error"):
            for line in out.splitlines():
                if line.startswith("http"):
                    self.pr_url = line.strip()
        return out

    def gh_issue_comment(self, number, body):
        refusal = self._confirm(f"comment on issue #{number}:\n\n{body}\n")
        if refusal:
            return refusal
        return self._gh("issue", "comment", str(number), "--body", body) or "comment posted"


# name, description, properties, required, needs_write
SCHEMA = [
    ("gh_issue_list", "List issues in the repository.",
     {"state": {"type": "string", "enum": ["open", "closed", "all"]},
      "limit": {"type": "integer"}}, [], False),
    ("gh_issue_view", "Read one issue in full, with its body and comments.",
     {"number": {"type": "integer"}}, ["number"], False),
    ("list_files", "List files in a directory of the checkout.",
     {"path": {"type": "string", "description": "Relative to the repo root."}}, [], False),
    ("read_file", "Read a file from the checkout.",
     {"path": {"type": "string"}}, ["path"], False),
    ("search_files", "Search the checkout for a string. Use this to find where something lives.",
     {"pattern": {"type": "string"}, "path": {"type": "string"}}, ["pattern"], False),
    ("git_diff", "Show the uncommitted changes you have made so far.", {}, [], False),
    ("git_branch", "Create and switch to a working branch. Do this before editing anything.",
     {"name": {"type": "string", "description": "Short branch name, e.g. issue-12-fix-typo."}},
     ["name"], True),
    ("write_file", "Write a file in the checkout. Give the complete new contents.",
     {"path": {"type": "string"}, "content": {"type": "string"}}, ["path", "content"], True),
    ("git_commit", "Commit everything you have changed.",
     {"message": {"type": "string"}}, ["message"], True),
    ("gh_pr_create", "Open a DRAFT pull request for a human to review.",
     {"title": {"type": "string"}, "body": {"type": "string"}}, ["title", "body"], True),
    ("gh_issue_comment", "Post a comment on an issue.",
     {"number": {"type": "integer"}, "body": {"type": "string"}}, ["number", "body"], True),
]


def tool_specs(include_write):
    out = []
    for name, desc, props, required, needs_write in SCHEMA:
        if needs_write and not include_write:
            continue
        out.append({"type": "function", "function": {
            "name": name, "description": desc,
            "parameters": {"type": "object", "properties": props, "required": required},
        }})
    return out


# --------------------------------------------------------------------------

def post(path, payload, timeout=600):
    req = urllib.request.Request(
        f"{BASE_URL}{path}", data=json.dumps(payload).encode(),
        headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        die(f"{e.code} from {BASE_URL}{path}: {e.read().decode()[:400]}")
    except urllib.error.URLError as e:
        die(f"cannot reach {BASE_URL} ({e.reason})\n  check:  systemctl status lmstudio-server")


def loaded_model():
    try:
        with urllib.request.urlopen(f"{BASE_URL}/models", timeout=10) as r:
            data = json.load(r)
        ids = [m["id"] for m in data.get("data", [])]
        return ids[0] if ids else None
    except Exception:
        return None


def chat(messages, tools):
    payload = {"messages": messages, "tools": tools, "temperature": 0.2}
    if MODEL:
        payload["model"] = MODEL
    return post("/chat/completions", payload)["choices"][0]["message"]


def _plain(messages, timeout=300):
    """A completion with no tools, so a tool-parsing bug cannot mask a model
    that is simply not generating."""
    payload = {"messages": messages, "temperature": 0.2, "max_tokens": 120}
    if MODEL:
        payload["model"] = MODEL
    return post("/chat/completions", payload, timeout=timeout)


def selftest():
    """Four stages, in dependency order. Each one prints what it saw, so a
    failure says which layer broke rather than just 'it did not work'."""
    import time

    print(f"{BOLD}1. endpoint{RST}")
    print(f"   {BASE_URL}")
    model = loaded_model()
    if not model:
        print(f"   {RED}FAIL{RST} no model loaded")
        print("\n   LM Studio:  lms ps    then    lms load <model>")
        print("   Ollama:     ollama list    then    ollama pull hermes3:3b")
        return 1
    print(f"   {GRN}ok{RST}  reachable")

    print(f"\n{BOLD}2. model{RST}")
    print(f"   {GRN}ok{RST}  {model}")

    print(f"\n{BOLD}3. inference{RST}")
    print(f"   {DIM}asking: 'In one short sentence, what is a Raspberry Pi?'{RST}")
    started = time.time()
    try:
        data = _plain([{"role": "user",
                        "content": "In one short sentence, what is a Raspberry Pi?"}])
    except SystemExit:
        raise
    elapsed = time.time() - started
    answer = (data["choices"][0]["message"].get("content") or "").strip()
    if not answer:
        print(f"   {RED}FAIL{RST} the model returned nothing")
        return 1
    print(f"   {GRN}ok{RST}  {answer[:200]}")

    # tok/s is the number that tells you whether this is usable day to day.
    tokens = (data.get("usage") or {}).get("completion_tokens")
    if tokens and elapsed > 0:
        rate = tokens / elapsed
        verdict = ("comfortable" if rate >= 5 else
                   "usable but slow" if rate >= 2 else
                   "painful - consider a smaller model")
        print(f"   {DIM}{tokens} tokens in {elapsed:.1f}s = {rate:.1f} tok/s ({verdict}){RST}")
    else:
        print(f"   {DIM}{elapsed:.1f}s to first complete answer{RST}")

    print(f"\n{BOLD}4. tool calling{RST}")
    print(f"   {DIM}offering tools and asking it to list issues{RST}")
    msg = chat([{"role": "system", "content": "You have tools. Use them rather than guessing."},
                {"role": "user", "content": "List the open issues in this repository."}],
               tool_specs(include_write=False))
    calls = msg.get("tool_calls") or []
    if calls:
        names = ", ".join(c["function"]["name"] for c in calls)
        print(f"   {GRN}ok{RST}  returned tool_calls: {names}")
        print(f"\n{GRN}{BOLD}Local AI is working.{RST} pi5-agent, opencode and hermes can all use it.")
        return 0

    print(f"   {RED}FAIL{RST} no tool_calls; it replied with text instead:")
    print(DIM + "   " + (msg.get("content") or "(empty)")[:300] + RST)
    print(f"\n{YEL}Inference works, tool calling does not.{RST}")
    print("The model emits tool calls in its own format and the runtime has to parse")
    print("them into OpenAI-shaped tool_calls. That parsing is what is missing.")
    print("\nChat and opencode will still work. pi5-agent and hermes-agent need this.")
    print("Known-good combination to fall back to:")
    print("  make app APP=ollama && pi5-agent --backend ollama --selftest")
    return 1


SYSTEM = """You are a careful engineer working on a repository, running locally
on a Raspberry Pi. You work one issue at a time.

How to work:
1. Read the issue. Use search_files and read_file to find the relevant code.
   Never guess at file contents or issue text.
2. Call git_branch before you change anything.
3. Make the smallest change that addresses the issue. write_file takes the
   COMPLETE new contents of the file, so read it first.
4. git_commit with a clear message.
5. gh_pr_create as a draft, describing what you changed and what you were unsure
   about.

Rules:
- One tool call at a time. Read each result before the next step.
- Do not close issues or merge anything. A human reviews your work.
- If the issue is unclear or too large, say so and stop rather than guessing.
- Be brief in prose."""


def agent_loop(prompt, tools, include_write):
    messages = [{"role": "system", "content": SYSTEM},
                {"role": "user", "content": prompt}]
    specs = tool_specs(include_write)

    for turn in range(MAX_TURNS):
        msg = chat(messages, specs)
        calls = msg.get("tool_calls") or []
        if not calls:
            print("\n" + (msg.get("content") or "(no answer)").strip())
            break
        messages.append(msg)
        for call in calls:
            name = call["function"]["name"]
            try:
                args = json.loads(call["function"].get("arguments") or "{}")
            except json.JSONDecodeError:
                result = "error: arguments were not valid JSON"
            else:
                fn = getattr(tools, name, None)
                if fn is None:
                    result = f"error: no such tool: {name}"
                else:
                    shown = ", ".join(
                        f"{k}={(v[:40] + '…') if isinstance(v, str) and len(v) > 40 else v!r}"
                        for k, v in args.items())
                    print(f"{DIM}  [{turn + 1}] {name}({shown}){RST}")
                    try:
                        result = fn(**args)
                    except TypeError as exc:
                        result = f"error: wrong arguments for {name}: {exc}"
            if len(result) > MAX_TOOL_CHARS:
                result = result[:MAX_TOOL_CHARS] + "\n...(truncated)"
            messages.append({"role": "tool", "tool_call_id": call.get("id", name),
                             "content": result})
    else:
        warn(f"gave up after {MAX_TURNS} turns")

    if tools.branch:
        print(f"\n{BOLD}Review it:{RST}")
        print(f"  git -C {tools.workdir} diff {tools.default_branch()}...{tools.branch}")
        print(f"  gh pr view --web")
        print(f"\nNothing was merged or closed. That is your call.")
    return 0


LABEL = os.environ.get("AGENT_LABEL", "pi-agent")
LABEL_DONE = os.environ.get("AGENT_LABEL_DONE", "pi-agent-done")
LABEL_FAILED = os.environ.get("AGENT_LABEL_FAILED", "pi-agent-failed")


def queue(args):
    """Work every open issue carrying the trigger label.

    Idempotence comes from the labels and from the branch: an issue whose
    agent/issue-N branch already exists is treated as already attempted, so a
    rerun after a crash does not duplicate work or reopen the same PR.
    """
    probe = Tools(args.workdir, args.repo, False, True)

    listing = probe._gh("issue", "list", "--state", "open", "--label", LABEL,
                        "--json", "number,title", "--limit", "20")
    if listing.startswith("error"):
        die(listing)
    try:
        issues = json.loads(listing or "[]")
    except json.JSONDecodeError:
        die(f"could not parse the issue list: {listing[:200]}")

    if not issues:
        say(f"no open issues labelled '{LABEL}'")
        return 0

    say(f"{len(issues)} issue(s) labelled '{LABEL}'")
    if not args.allow_write:
        for it in issues:
            print(f"   #{it['number']}  {it['title']}")
        warn("read-only: add --allow-write to actually work them")
        return 0

    default = probe.default_branch()
    worked = failed = skipped = 0

    for it in issues:
        num, title = it["number"], it["title"]
        branch = f"{BRANCH_PREFIX}issue-{num}"

        existing = probe._git("ls-remote", "--heads", "origin", branch)
        if existing and not existing.startswith("error"):
            print(f"\n{DIM}skip #{num}: {branch} already exists on origin{RST}")
            skipped += 1
            continue

        print(f"\n{BOLD}=== #{num}  {title}{RST}")

        # Each issue starts from a clean default branch, or its diff would
        # include the previous issue's work.
        probe._git("switch", default)
        dirty = probe._git("status", "--porcelain")
        if dirty and not dirty.startswith("error"):
            warn(f"working tree dirty before #{num}; skipping")
            skipped += 1
            continue

        tools = Tools(args.workdir, args.repo, True, True)
        prompt = (f"Work issue #{num}. Read it with gh_issue_view first, then find the "
                  f"relevant code before changing anything. Use branch name issue-{num}.")
        try:
            agent_loop(prompt, tools, True)
        except SystemExit:
            raise
        except Exception as exc:                      # noqa: BLE001
            warn(f"#{num} raised: {exc}")

        if tools.pr_url:
            tools._gh("issue", "edit", str(num),
                      "--add-label", LABEL_DONE, "--remove-label", LABEL)
            tools._gh("issue", "comment", str(num),
                      "--body", f"Draft PR opened by the local agent: {tools.pr_url}\n\n"
                                f"Model output is unreviewed. Please read the diff.")
            print(f"{GRN}#{num} -> {tools.pr_url}{RST}")
            worked += 1
        else:
            tools._gh("issue", "edit", str(num),
                      "--add-label", LABEL_FAILED, "--remove-label", LABEL)
            tools._gh("issue", "comment", str(num),
                      "--body", "The local agent could not complete this one. "
                                "It may be too large or too vague for a small model; "
                                "no pull request was opened.")
            warn(f"#{num} produced no PR")
            failed += 1

    probe._git("switch", default)
    print(f"\n{BOLD}{worked} PR(s) opened, {failed} failed, {skipped} skipped{RST}")
    print("Nothing was merged or closed - review the drafts.")
    return 0


def main():
    ap = argparse.ArgumentParser(description="Work GitHub issues with the local model.")
    ap.add_argument("prompt", nargs="?")
    ap.add_argument("--selftest", action="store_true")
    ap.add_argument("--issue", type=int, help="work this issue end to end")
    ap.add_argument("--repo", help="owner/name; defaults to the checkout's remote")
    ap.add_argument("-C", "--workdir", default=".")
    ap.add_argument("--allow-write", action="store_true",
                    help="permit branching, editing, committing and opening a draft PR")
    ap.add_argument("--yes", action="store_true", help="skip confirmation for PRs and comments")
    ap.add_argument("--force", action="store_true", help="proceed even with a dirty tree")
    ap.add_argument("--backend", choices=["lmstudio", "ollama"],
                    help="shorthand for the endpoint port")
    ap.add_argument("--queue", action="store_true",
                    help=f"work every open issue labelled '{LABEL}'")
    args = ap.parse_args()

    global BASE_URL
    if args.backend == "ollama":
        BASE_URL = "http://127.0.0.1:11434/v1"
    elif args.backend == "lmstudio":
        BASE_URL = "http://127.0.0.1:1234/v1"

    if args.selftest:
        sys.exit(selftest())
    if args.queue:
        sys.exit(queue(args))
    if not args.prompt and args.issue is None:
        ap.error("give a prompt, --issue N, --queue, or --selftest")

    tools = Tools(args.workdir, args.repo, args.allow_write, args.yes)

    if args.allow_write:
        # Mixing the model's edits into your work in progress makes the diff
        # useless as a review artefact.
        dirty = tools._git("status", "--porcelain")
        if dirty and not dirty.startswith("error") and not args.force:
            die("the working tree has uncommitted changes.\n"
                "  Commit or stash them first, so the review diff is only the agent's work.\n"
                "  Or pass --force.")

    if args.issue is not None:
        prompt = (f"Work issue #{args.issue}. Start by reading it with gh_issue_view, "
                  f"then find the relevant code before changing anything. "
                  f"Use branch name issue-{args.issue}.")
        if args.prompt:
            prompt += f"\n\nExtra instruction from the user: {args.prompt}"
        if not args.allow_write:
            warn("read-only: add --allow-write to let it branch, edit and open a draft PR")
    else:
        prompt = args.prompt

    sys.exit(agent_loop(prompt, tools, args.allow_write))


if __name__ == "__main__":
    main()
