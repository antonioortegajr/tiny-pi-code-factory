#!/usr/bin/env python3
"""Work a GitHub issue with the local model. No MCP, no cloud, no pip deps.

Single self-contained file - drop it into any repo's agent harness. It talks to
Ollama's OpenAI-compatible endpoint on localhost, and uses the `gh` and `git`
CLIs as its tool layer.

  pi5-agent --selftest              can the model call tools at all?
  pi5-agent --queue --allow-write   work every issue labelled agent:queued
  pi5-agent --issue 12              read issue 12, branch, work it, open a PR
  pi5-agent "summarise open issues" read-only question

The safety boundary is not "read nothing". It is: never touch the default
branch, never merge, never close. Work lands on an agent/ branch as a PR
for a human to review.
"""

import argparse
import json
import os
import re
import shutil
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.request

# Ollama's OpenAI-compatible endpoint. Override with AGENT_BASE_URL for anything
# else that speaks the same shape.
BASE_URL = os.environ.get("AGENT_BASE_URL", "http://127.0.0.1:11434/v1")
MODEL = os.environ.get("AGENT_MODEL_ID", "")
MAX_TURNS = int(os.environ.get("AGENT_MAX_TURNS", "20"))
MAX_TOOL_CHARS = int(os.environ.get("AGENT_MAX_TOOL_CHARS", "4000"))
# Lines per read_file page. The page is also capped by MAX_TOOL_CHARS, so this
# only matters for files with short lines.
READ_LINES = int(os.environ.get("AGENT_READ_LINES", "200"))
# Generous: a reasoning model on a CPU produces a few tokens a second, and the
# first request also waits for the weights to load from the SSD.
REQUEST_TIMEOUT = int(os.environ.get("AGENT_TIMEOUT", "900"))
BRANCH_PREFIX = os.environ.get("AGENT_BRANCH_PREFIX", "agent/")
SELF_REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
# Pull requests open ready for review. They used to be drafts, which was the only
# mechanical brake on a repo with no branch protection - set AGENT_PR_DRAFT=1 to
# put that back. What stands in its place: every PR and commit is signed with the
# machine and model that wrote it, and a PR opens ready for review, so the diff
# is in front of you before anything merges.
PR_DRAFT = os.environ.get("AGENT_PR_DRAFT", "0") == "1"
# Merging the PR closes its issue. AGENT_PR_CLOSES=0 downgrades the link to
# "Refs #N", which cross-links and closes nothing - worth doing while a harness
# is new enough that a PR may not be about the issue it claims.
PR_CLOSES = os.environ.get("AGENT_PR_CLOSES", "1") == "1"
AGENT_NAME = "pi5-agent"
# Empty by default. Work on this repo lands on a branch as a PR like any
# other, and reviewing that PR is the guard - a blanket write ban would also
# stop you asking the agent to improve its own scripts, which is reasonable.
# Set it if you want belt and braces.
PROTECTED = [p for p in os.environ.get("AGENT_PROTECTED_PATHS", "").split(",") if p]

# Shapes that are secrets wherever they appear. Deliberately narrow: a check
# that cries wolf gets switched off, and then it protects nothing.
SECRET_PATTERNS = [
    (re.compile(r"github_pat_[A-Za-z0-9_]{20,}"), "GitHub fine-grained token"),
    (re.compile(r"\bgh[pousr]_[A-Za-z0-9]{30,}"), "GitHub token"),
    (re.compile(r"-----BEGIN (?:RSA |OPENSSH |EC |DSA |PGP )?PRIVATE KEY"), "private key"),
    (re.compile(r"\bAKIA[0-9A-Z]{16}\b"), "AWS access key id"),
    (re.compile(r"\bsk-[A-Za-z0-9]{32,}"), "OpenAI-style API key"),
    (re.compile(r"\bxox[abprs]-[A-Za-z0-9-]{10,}"), "Slack token"),
    (re.compile(r"\b\d{9,10}:AA[A-Za-z0-9_-]{33}\b"), "Telegram bot token"),
    (re.compile(r"eyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\."), "JWT"),
]


def scan_for_secrets(diff):
    """Return a list of (label, line number) for secret-shaped strings in added
    lines. Only added lines: what is already in the file is not this commit's
    doing, and flagging it would block every commit to that file."""
    hits = []
    lineno = 0
    for line in diff.splitlines():
        if line.startswith("+++") or line.startswith("---"):
            continue
        if not line.startswith("+"):
            continue
        lineno += 1
        for pattern, label in SECRET_PATTERNS:
            if pattern.search(line):
                hits.append((label, line[1:].strip()[:60]))
                break
    return hits
# Repo-specific instructions get prepended to the system prompt. AGENTS.md is the
# cross-tool convention (opencode reads it too), so one file steers both agents.
# Bounded, because context here is 8K and the tool results have to fit in it.
AGENTS_MD_MAX = int(os.environ.get("AGENT_INSTRUCTIONS_MAX_CHARS", "3000"))
# Instructions that hold for every repo on this machine, prepended before the
# checkout's own AGENTS.md. Its own smaller budget on purpose: the repo file
# knows the build command and the layout, which matters more than anything
# stated globally, and the two share one 8K context.
GLOBAL_MD_MAX = int(os.environ.get("AGENT_GLOBAL_INSTRUCTIONS_MAX_CHARS", "1200"))
GLOBAL_INSTRUCTIONS = os.environ.get("AGENT_GLOBAL_INSTRUCTIONS", "")
# Reasoning models narrate before answering. Set AGENT_SHOW_THINKING=1 to keep it.
SHOW_THINKING = os.environ.get("AGENT_SHOW_THINKING", "0") == "1"
# native = OpenAI tool_calls. text = a plain TOOL:/ARGS: protocol the model
# writes and we parse. auto probes native once and falls back.
TOOL_MODE = os.environ.get("AGENT_TOOL_MODE", "auto").lower()

_tty = sys.stdout.isatty()
DIM, BOLD, RED, GRN, YEL, BLU, RST = (
    ("\033[2m", "\033[1m", "\033[31m", "\033[32m", "\033[33m", "\033[34m", "\033[0m")
    if _tty else ("", "", "", "", "", "", "")
)


def say(m): print(f"{BLU}==>{RST} {m}")
def warn(m): print(f"{YEL}!{RST} {m}", file=sys.stderr)
def die(m, code=1):
    print(f"{RED}{BOLD}ERROR:{RST} {m}", file=sys.stderr)
    sys.exit(code)


_THINK_TAGS = re.compile(r"<(think|thinking|reasoning)>.*?</\1>", re.S | re.I)
# A labelled preamble ending at the first blank line, e.g. "Thinking Process: …".
_THINK_LABEL = re.compile(
    r"\A\s*(?:thinking process|thought process|reasoning|thinking|thought)\s*:.*?(?:\n\s*\n|\Z)",
    re.S | re.I)


def strip_thinking(text):
    """Remove a reasoning model's narration.

    Stripped from the conversation history too, not just the display: on an 8K
    context, several turns of narration crowd out the tool results the model
    actually needs.
    """
    if not text or SHOW_THINKING:
        return text
    cleaned = _THINK_TAGS.sub("", text)
    cleaned = _THINK_LABEL.sub("", cleaned)
    # An unclosed <think> means the answer never arrived; keep the text rather
    # than return nothing.
    if "<think" in cleaned.lower() and "</think" not in cleaned.lower():
        return text.strip()
    return cleaned.strip() or text.strip()


def run(cmd, cwd, timeout=120):
    """Fixed argv, never a shell string, so nothing the model emits can be
    interpreted as shell syntax."""
    try:
        p = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, timeout=timeout)
    except FileNotFoundError:
        return 1, f"error: {cmd[0]} is not installed"
    except subprocess.TimeoutExpired:
        return 1, f"error: {cmd[0]} timed out"
    out = (p.stdout or "").strip()
    err = (p.stderr or "").strip()
    if p.returncode != 0:
        return p.returncode, f"error: {err or out or cmd[0] + ' failed'}"
    return 0, out


class Tools:
    def __init__(self, workdir, repo=None, allow_write=False, assume_yes=False):
        self.workdir = os.path.realpath(workdir)
        self.repo = repo
        self.allow_write = allow_write
        self.assume_yes = assume_yes
        self.branch = None      # set once we switch to an agent branch
        self.touched = set()
        self.pr_url = ""        # set when a PR is actually opened
        self.issue_number = None  # so a PR can close the issue it came from
        self.gave_up = ""       # the model's own reason for stopping, if it said one
        self.tools_used = 0     # so a failure can say what happened, not guess

    # -- helpers -----------------------------------------------------------

    def _gh(self, *args):
        cmd = ["gh", *args]
        if self.repo and args and args[0] in ("issue", "pr", "repo"):
            cmd += ["--repo", self.repo]
        return run(cmd, self.workdir)[1]

    def _git(self, *args):
        return run(["git", *args], self.workdir)[1]

    def _safe_path(self, path):
        full = os.path.realpath(os.path.join(self.workdir, path))
        if full != self.workdir and not full.startswith(self.workdir + os.sep):
            return None
        if os.sep + ".git" + os.sep in full + os.sep:
            return None          # the model has no business rewriting git internals
        return full

    def is_protected(self, path):
        """True for the agent's own executable code, when it is working on the
        repo it is running from."""
        if os.path.realpath(self.workdir) != os.path.realpath(SELF_REPO):
            return False
        rel = os.path.normpath(path).lstrip("./")
        return any(rel == p.rstrip("/") or rel.startswith(p) for p in PROTECTED)

    def _confirm(self, what):
        """Only for things that leave this machine. Local edits on a throwaway
        branch are reviewable and revertible, so they do not prompt."""
        if not self.allow_write:
            return "refused: read-only run. Rerun with --allow-write."
        if self.assume_yes:
            return None
        print(f"\n{YEL}The model wants to:{RST} {what}")
        try:
            ok = input("  Type 'yes' to allow: ").strip() == "yes"
        except EOFError:
            ok = False
        return None if ok else "refused: you declined this action."

    def current_branch(self):
        return self._git("rev-parse", "--abbrev-ref", "HEAD")

    def default_branch(self):
        ref = self._git("symbolic-ref", "refs/remotes/origin/HEAD")
        if ref.startswith("error"):
            return "main"
        return ref.rsplit("/", 1)[-1]

    # -- read --------------------------------------------------------------

    def gh_issue_list(self, state="open", limit=20):
        return self._gh("issue", "list", "--state", str(state), "--limit", str(limit),
                        "--json", "number,title,state,labels,updatedAt")

    def gh_issue_view(self, number):
        return self._gh("issue", "view", str(number),
                        "--json", "number,title,state,body,labels,comments")

    def list_files(self, path="."):
        full = self._safe_path(path)
        if not full:
            return "error: path is outside the working directory"
        if not os.path.isdir(full):
            return f"error: not a directory: {path}"
        names = sorted(n for n in os.listdir(full) if n != ".git")
        return "\n".join(names) or "(empty)"

    def read_file(self, path, offset=1, limit=None):
        """Read a page of a file, not all of it.

        Returning the whole file was a dead end on anything real. Every tool
        result is cut at AGENT_MAX_TOOL_CHARS, so a 32 KB README arrived as its
        first 12% with no way to see the rest - and an issue about its last
        lines became unachievable: search_files would report line 783, then
        read_file would hand back line 1 onwards, forever. The model re-read the
        same head until the repeat guard stopped it.

        So: line-addressed pages, a header saying which lines these are, and a
        footer saying how to get the next ones. The page is trimmed to fit the
        result budget, so the footer is never the part that gets cut off.

        No line-number prefixes on the text itself, deliberately. replace_in_file
        needs the old text verbatim, and a model that copies "783: foo" back
        into it produces a match that does not exist. search_files is where line
        numbers come from; this is where the exact text does.
        """
        full = self._safe_path(path)
        if not full:
            return "error: path is outside the working directory"
        if not os.path.isfile(full):
            return f"error: no such file: {path}"
        try:
            with open(full, encoding="utf-8", errors="replace") as fh:
                lines = fh.read().splitlines(keepends=True)
        except OSError as exc:
            return f"error: {exc}"

        total = len(lines)
        if total == 0:
            return f"({path} is empty)"
        try:
            start = max(1, int(offset))
            want = int(limit) if limit else READ_LINES
        except (TypeError, ValueError):
            return "error: offset and limit must be whole numbers"
        if start > total:
            return (f"error: {path} has {total} lines; offset {start} is past "
                    f"the end. Use search_files to find the line you want.")

        # Fit the page to the result budget, leaving room for the notices. A
        # page trimmed here is honest about it in the footer, unlike the blanket
        # truncation in dispatch().
        budget = MAX_TOOL_CHARS - 300
        page, used = [], 0
        for line in lines[start - 1:start - 1 + max(1, want)]:
            if page and used + len(line) > budget:
                break
            page.append(line)
            used += len(line)
        end = start - 1 + len(page)

        head = f"[{path} lines {start}-{end} of {total}]\n"
        body = "".join(page)
        if end >= total:
            return head + body
        return (head + body +
                f"\n[{total - end} more lines. Read them with "
                f"read_file(path=\"{path}\", offset={end + 1}), or use "
                f"search_files to jump straight to the line you need.]")

    def search_files(self, pattern, path="."):
        full = self._safe_path(path)
        if not full:
            return "error: path is outside the working directory"
        code, out = run(["git", "grep", "-n", "--", pattern, "--", path], self.workdir)
        if code != 0:
            return "no matches"
        return out

    def git_diff(self):
        out = self._git("diff")
        return out or "(no uncommitted changes)"

    # -- write, on an agent branch only ------------------------------------

    def git_branch(self, name):
        """Always prefixed, always off the default branch. This is the whole
        containment story: nothing the model does lands on main."""
        if not self.allow_write:
            return "refused: read-only run. Rerun with --allow-write."
        slug = re.sub(r"[^a-zA-Z0-9._/-]+", "-", name).strip("-/") or "work"
        if not slug.startswith(BRANCH_PREFIX):
            slug = BRANCH_PREFIX + slug
        # When there is an issue, its number is not the model's to choose.
        # agent/issue-N is the queue's only idempotence key - it is how a rerun
        # knows this issue was already attempted - and a model working #3 has
        # twice now named its branch after #1. Take the name back.
        if self.issue_number is not None:
            forced = f"{BRANCH_PREFIX}issue-{self.issue_number}"
            if slug != forced:
                print(f"{DIM}  branch name {slug} -> {forced}{RST}")
            slug = forced
        out = self._git("switch", "-c", slug)
        if out.startswith("error"):
            out = self._git("switch", slug)
            if out.startswith("error"):
                return out
        self.branch = slug
        return f"now on branch {slug}"

    def write_file(self, path, content):
        if not self.allow_write:
            return "refused: read-only run. Rerun with --allow-write."
        if not self.branch:
            return ("refused: not on an agent branch yet. "
                    "Call git_branch first so the work is reviewable.")
        if self.is_protected(path):
            return (f"refused: {path} is this agent's own code. Docs and config "
                    "in this repo are editable, its executable parts are not.")
        full = self._safe_path(path)
        if not full:
            return "error: path is outside the working directory"
        try:
            os.makedirs(os.path.dirname(full), exist_ok=True)
            with open(full, "w", encoding="utf-8") as fh:
                fh.write(content)
        except OSError as exc:
            return f"error: {exc}"
        self.touched.add(path)
        print(f"{GRN}  wrote{RST} {path} ({len(content)} bytes)")
        return f"wrote {path}"

    def append_file(self, path, content):
        """Add to the end of a file without reproducing it.

        write_file needs the model to emit the whole file, which is impossible
        for anything large on an 8K context - the failure is silent, an empty
        reply. Most small issues are an append or a replacement, so give those
        their own tools rather than making every edit a full rewrite."""
        if not self.allow_write:
            return "refused: read-only run. Rerun with --allow-write."
        if not self.branch:
            return "refused: call git_branch first."
        if self.is_protected(path):
            return f"refused: {path} is this agent's own code."
        full = self._safe_path(path)
        if not full:
            return "error: path is outside the working directory"
        try:
            existing = ""
            if os.path.isfile(full):
                with open(full, encoding="utf-8", errors="replace") as fh:
                    existing = fh.read()
            sep = "" if (not existing or existing.endswith("\n")) else "\n"
            with open(full, "a", encoding="utf-8") as fh:
                fh.write(sep + content.rstrip("\n") + "\n")
        except OSError as exc:
            return f"error: {exc}"
        self.touched.add(path)
        print(f"{GRN}  appended{RST} {len(content)} bytes to {path}")
        return f"appended to {path}"

    def replace_in_file(self, path, old, new):
        """Swap one exact string for another. The workhorse for editing a large
        file: the model only has to name the part it is changing."""
        if not self.allow_write:
            return "refused: read-only run. Rerun with --allow-write."
        if not self.branch:
            return "refused: call git_branch first."
        if self.is_protected(path):
            return f"refused: {path} is this agent's own code."
        full = self._safe_path(path)
        if not full:
            return "error: path is outside the working directory"
        if not os.path.isfile(full):
            return f"error: no such file: {path}"
        try:
            with open(full, encoding="utf-8", errors="replace") as fh:
                text = fh.read()
        except OSError as exc:
            return f"error: {exc}"
        count = text.count(old)
        if count == 0:
            return ("error: that exact text is not in the file. Use read_file "
                    "and copy the text you want to replace verbatim.")
        if count > 1:
            return (f"error: that text appears {count} times. Include more "
                    "surrounding lines so it matches exactly once.")
        try:
            with open(full, "w", encoding="utf-8") as fh:
                fh.write(text.replace(old, new, 1))
        except OSError as exc:
            return f"error: {exc}"
        self.touched.add(path)
        print(f"{GRN}  edited{RST} {path}")
        return f"replaced one occurrence in {path}"

    def git_commit(self, message):
        if not self.allow_write:
            return "refused: read-only run. Rerun with --allow-write."
        if not self.branch:
            return "refused: not on an agent branch."
        # The branch that is checked out, not the one we think we made. settle()
        # runs on more than one exit path and can be reached after the switch
        # back, and this guard passing on a stale name is how a "wip: unfinished
        # agent run" commit landed on main.
        here = self.current_branch()
        if here == self.default_branch():
            return "refused: will not commit to the default branch."
        if here != self.branch:
            return (f"refused: on {here}, not the agent branch {self.branch}.")
        if not self.touched:
            return "refused: no files were touched by this agent."

        # Separate arguments, never a joined string, and -- so a path that
        # looks like an option cannot become one.
        self._git("add", "--", *sorted(self.touched))

        # Check what is actually staged, after add, before commit. A secret in a
        # diff is the one mistake that a later revert does not undo.
        staged = self._git("diff", "--cached")
        if staged and not staged.startswith("error"):
            hits = scan_for_secrets(staged)
            if hits:
                self._git("reset")
                lines = "\n".join(f"  {label}: {snippet}" for label, snippet in hits[:5])
                print(f"{RED}  refusing to commit - possible secrets staged{RST}")
                return ("refused: the staged changes look like they contain "
                        f"secrets, so nothing was committed:\n{lines}\n"
                        "Remove them, or add the file to .gitignore.")

        # A trailer, not prose: a squash merge keeps the commit message and
        # discards the PR body, so this is what survives in git history.
        trailer = (f"Agent: {AGENT_NAME} on {socket.gethostname()} "
                   f"({model_id()})")
        if trailer not in message:
            message = message.rstrip() + "\n\n" + trailer
        out = self._git("commit", "-m", message)
        return out if not out.startswith("error") else out

    # -- outward facing: these prompt ---------------------------------------

    def gh_pr_create(self, title, body):
        kind = "DRAFT pull request" if PR_DRAFT else "pull request"
        refusal = self._confirm(f"open a {kind} titled {title!r}")
        if refusal:
            return refusal
        if not self.branch:
            return "refused: no agent branch to open a PR from."

        # Link the PR to its issue, and by default let merging close it.
        #
        # The keyword cannot depend on the model remembering to write one -
        # GitHub only closes on close/fixes/resolves, and "addresses #9" or a
        # bare "#9" look like a link while doing nothing. So the harness ensures
        # exactly one, whichever way it is configured.
        #
        # The risk this carries is real and was seen here: a drifting model
        # opened a PR that redid a different, already-merged ticket, and the
        # stamped keyword closed the wrong issue on merge. AGENT_PR_CLOSES=0
        # downgrades every link to "Refs #N" if you want closing back in human
        # hands. What keeps the default honest is that the PR is signed and
        # opens ready for review - you see the diff before it merges.
        if self.issue_number:
            num = self.issue_number
            closing = re.compile(
                r"\b(?:close[sd]?|fix(?:e[sd])?|resolve[sd]?)(\s+#%d\b)" % num,
                re.I)
            if PR_CLOSES:
                if not closing.search(body or ""):
                    body = (body or "").rstrip() + f"\n\nCloses #{num}"
            else:
                body = closing.sub(r"Refs\1", body or "")
                if f"#{num}" not in body:
                    body = body.rstrip() + f"\n\nRefs #{num}"
        push = self._git("push", "-u", "origin", self.branch)
        if push.startswith("error"):
            return push
        # Draft, always. A human opens it for review; nothing auto-merges.
        body = body.rstrip() + f"\n\n---\n{signature()}"
        args = ["pr", "create", "--title", title, "--body", body, "--head", self.branch]
        if PR_DRAFT:
            args.insert(2, "--draft")
        out = self._gh(*args)
        if not out.startswith("error"):
            for line in out.splitlines():
                if line.startswith("http"):
                    self.pr_url = line.strip()
        return out

    def gh_issue_comment(self, number, body):
        refusal = self._confirm(f"comment on issue #{number}:\n\n{body}\n")
        if refusal:
            return refusal
        return self._gh("issue", "comment", str(number), "--body", body) or "comment posted"

    # -- give up -----------------------------------------------------------

    def cannot_complete(self, reason):
        """The honest exit.

        Without one, a model that cannot do the job has only prose to say so,
        and prose is indistinguishable from a model that simply did not answer.
        The queue then guesses at what went wrong. Worse, a small model asked
        for something it cannot obtain tends to invent an answer rather than
        stop, and an invented answer arrives as a plausible-looking PR.

        A tool makes stopping a first-class outcome: the reason is the model's
        own words, it reaches the issue verbatim, and the run ends there.
        """
        # One line, bounded: it is quoted into a Markdown blockquote on the
        # issue, where a stray newline ends the quote mid-reason.
        self.gave_up = " ".join((reason or "").split())[:500] or "no reason given"
        return "acknowledged: stopping here. Your reason will be posted on the issue."


# name, description, properties, required, needs_write
SCHEMA = [
    ("gh_issue_list", "List issues in the repository.",
     {"state": {"type": "string", "enum": ["open", "closed", "all"]},
      "limit": {"type": "integer"}}, [], False),
    ("gh_issue_view", "Read one issue in full, with its body and comments.",
     {"number": {"type": "integer"}}, ["number"], False),
    ("list_files", "List files in a directory of the checkout.",
     {"path": {"type": "string", "description": "Relative to the repo root."}}, [], False),
    ("read_file", "Read a file from the checkout. Long files come back one page "
                  "at a time; the result says which lines you got and how to "
                  "read the next ones. Use offset to jump to a line that "
                  "search_files found.",
     {"path": {"type": "string"},
      "offset": {"type": "integer", "description": "First line to read, 1-based."},
      "limit": {"type": "integer", "description": "How many lines. Default 200."}},
     ["path"], False),
    ("search_files", "Search the checkout for a string. Use this to find where something lives.",
     {"pattern": {"type": "string"}, "path": {"type": "string"}}, ["pattern"], False),
    ("git_diff", "Show the uncommitted changes you have made so far.", {}, [], False),
    ("git_branch", "Create and switch to a working branch. Do this before editing anything.",
     {"name": {"type": "string", "description": "Short branch name, e.g. issue-12-fix-typo."}},
     ["name"], True),
    ("append_file", "Add text to the end of a file. Use this rather than write_file when you are only adding.",
     {"path": {"type": "string"}, "content": {"type": "string"}}, ["path", "content"], True),
    ("replace_in_file", "Replace one exact piece of text in a file. Use this to change part of a large file.",
     {"path": {"type": "string"},
      "old": {"type": "string", "description": "Exact existing text, copied verbatim."},
      "new": {"type": "string", "description": "What it becomes."}},
     ["path", "old", "new"], True),
    ("write_file", "Write a whole file. Only for a new or very small file - you must give the complete contents.",
     {"path": {"type": "string"}, "content": {"type": "string"}}, ["path", "content"], True),
    ("git_commit", "Commit everything you have changed.",
     {"message": {"type": "string"}}, ["message"], True),
    ("gh_pr_create", "Open a pull request for a human to review.",
     {"title": {"type": "string"}, "body": {"type": "string"}}, ["title", "body"], True),
    ("gh_issue_comment", "Post a comment on an issue.",
     {"number": {"type": "integer"}, "body": {"type": "string"}}, ["number", "body"], True),
    ("cannot_complete", "Stop and report that you cannot do this issue. Use it when the "
                        "issue needs information you have no tool to obtain, or is "
                        "unclear or too large. Stopping is a correct outcome; guessing "
                        "is not.",
     {"reason": {"type": "string",
                 "description": "One or two sentences: what you needed and could not get."}},
     ["reason"], False),
]


TEXT_PROTOCOL = """
To use a tool, reply with EXACTLY these two lines and nothing else:

TOOL: <tool_name>
ARGS: {"arg": "value"}

Use {} for a tool that takes no arguments. One tool per reply. After you see the
result you may use another tool, or give your final answer as plain prose with
no TOOL: line.

Available tools:
"""

_TEXT_CALL = re.compile(
    r"TOOL:\s*([A-Za-z_][A-Za-z0-9_]*)\s*(?:\n+ARGS:\s*(\{.*?\}))?\s*(?:\n|\Z)",
    re.S)


def tools_as_text(specs):
    """Describe the tools in prose, for a model whose runtime cannot parse
    native tool calls."""
    lines = []
    for spec in specs:
        fn = spec["function"]
        props = fn["parameters"].get("properties", {})
        required = set(fn["parameters"].get("required", []))
        if props:
            args = ", ".join(
                f"{k}{'' if k in required else '?'}" for k in props)
        else:
            args = "no arguments"
        lines.append(f"- {fn['name']}({args}) - {fn['description']}")
    return TEXT_PROTOCOL + "\n".join(lines)


def parse_text_call(content):
    """Pull a TOOL:/ARGS: pair out of a plain reply. Returns (name, args) or
    None if the model answered rather than called something."""
    if not content:
        return None
    match = _TEXT_CALL.search(content)
    if not match:
        return None
    name = match.group(1)
    raw = (match.group(2) or "{}").strip()
    try:
        args = json.loads(raw)
    except json.JSONDecodeError:
        return (name, None)          # signalled a call but mangled the JSON
    if not isinstance(args, dict):
        return (name, None)
    return (name, args)


def tool_specs(include_write):
    out = []
    for name, desc, props, required, needs_write in SCHEMA:
        if needs_write and not include_write:
            continue
        out.append({"type": "function", "function": {
            "name": name, "description": desc,
            "parameters": {"type": "object", "properties": props, "required": required},
        }})
    return out


# --------------------------------------------------------------------------

def post(path, payload, timeout=None):
    timeout = timeout or REQUEST_TIMEOUT
    req = urllib.request.Request(
        f"{BASE_URL}{path}", data=json.dumps(payload).encode(),
        headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        die(f"{e.code} from {BASE_URL}{path}: {e.read().decode()[:400]}")
    except TimeoutError:
        die(f"no reply within {timeout}s.\n"
            "  A reasoning model on a Pi is slow, and the first request also\n"
            "  loads the weights from disk. Either wait longer:\n"
            "    AGENT_TIMEOUT=1800 make llm-test\n"
            "  or use a model that does not think before answering:\n"
            "    ollama pull hermes3:3b && ollama run hermes3:3b")
    except urllib.error.URLError as e:
        # A socket timeout arrives wrapped in URLError on some paths.
        if isinstance(getattr(e, "reason", None), TimeoutError):
            die(f"no reply within {timeout}s - see AGENT_TIMEOUT")
        die(f"cannot reach {BASE_URL} ({e.reason})\n"
            "  check:  systemctl status ollama")


_RESOLVED_MODEL = None


def resolve_model():
    """The model id to send. Ollama requires one on every request, unlike
    servers that infer it from whatever is loaded, so ask the endpoint once and
    cache the answer."""
    global _RESOLVED_MODEL
    if MODEL:
        return MODEL
    if _RESOLVED_MODEL is None:
        _RESOLVED_MODEL = loaded_model() or ""
        if not _RESOLVED_MODEL:
            die("no model available at " + BASE_URL + "\n"
                "  ollama list    then    ollama pull qwen3.5:4b-q4_K_M\n"
                "  or pin one with AGENT_MODEL_ID=<id>")
    return _RESOLVED_MODEL


def signature():
    """Who wrote this, on what, with which weights.

    Unreviewed model output that reaches a pull request should say so on its
    face. The harness knows the model id - it sends it on every request - so the
    attribution does not depend on the model reporting anything about itself.
    """
    return (f"Written by `{AGENT_NAME}` on `{socket.gethostname()}` using "
            f"`{model_id()}`. Local model output, unreviewed - please read the "
            "diff.")


def model_id():
    """The model id for attribution. Never fatal, unlike resolve_model: a
    signature is not worth failing a commit over, and an endpoint that has gone
    away by now does not change who did the work."""
    return MODEL or _RESOLVED_MODEL or loaded_model() or "unknown model"


def loaded_model():
    try:
        with urllib.request.urlopen(f"{BASE_URL}/models", timeout=10) as r:
            data = json.load(r)
        ids = [m["id"] for m in data.get("data", [])]
        return ids[0] if ids else None
    except Exception:
        return None


def chat(messages, tools=None):
    payload = {"messages": messages, "temperature": 0.2, "model": resolve_model()}
    if tools:
        payload["tools"] = tools
    if not SHOW_THINKING:
        # "think" is Ollama-native; OpenAI-compatible endpoints ignore it.
        # Set "reasoning_effort": "none" to suppress narration on those endpoints.
        payload["think"] = False
        payload["reasoning_effort"] = "none"
    msg = post("/chat/completions", payload)["choices"][0]["message"]
    if msg.get("content"):
        msg["content"] = strip_thinking(msg["content"])
    return msg


SYSTEM = """You are a careful engineer working on a repository, running locally
on a Raspberry Pi. You work one issue at a time.

How to work:
1. Read the issue. Use search_files and read_file to find the relevant code.
   Never guess at file contents or issue text.
2. Call git_branch before you change anything.
3. Make the smallest change that addresses the issue:
   - adding to the end of a file -> append_file
   - changing part of a file -> replace_in_file, copying the old text verbatim
   - write_file only for a new or tiny file: it needs the COMPLETE contents,
     which you cannot produce for a large one
4. git_commit with a clear message.
5. gh_pr_create, describing what you changed and what you were unsure about.
   The issue is linked for you - you do not need to mention it.

Rules:
- Do not narrate your reasoning. No "Thinking Process:", no commentary on what
  you are about to do. Call a tool, or give the answer.
- One tool call at a time. Read each result before the next step.
- Do not close issues or merge anything. A human reviews your work.
- If the issue is unclear, too large, or needs a fact no tool can give you,
  call cannot_complete with the reason. Do not guess and do not invent a
  plausible answer - a wrong PR costs more than an honest stop.
- Be brief in prose."""


def _read_instructions(path, cap):
    """Read one instructions file, bounded. Returns (text, was_truncated)."""
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            text = fh.read().strip()
    except OSError:
        return "", False
    if not text:
        return "", False
    if len(text) > cap:
        return text[:cap] + "\n...(truncated)", True
    return text, False


def repo_instructions(workdir):
    """Load AGENTS.md, or CLAUDE.md as a fallback. Nearest file wins, matching
    the AGENTS.md convention for monorepos."""
    for name in ("AGENTS.md", "CLAUDE.md", ".github/AGENTS.md"):
        path = os.path.join(workdir, name)
        if not os.path.isfile(path):
            continue
        text, truncated = _read_instructions(path, AGENTS_MD_MAX)
        if text:
            return name, text, truncated
    return None, "", False


def global_instructions():
    """Instructions for every repo on this machine.

    A per-repo AGENTS.md cannot say "you are running unattended on a Pi, never
    touch lockfiles" without that being copied into every checkout and drifting.
    This is where machine-level rules live. The repo file is still appended
    after it, so the nearest file wins where the two disagree - the same
    precedence AGENTS.md uses for monorepos.

    Note it does NOT reach opencode: an escalated run reads the project's
    AGENTS.md and opencode's own global config, not this file.
    """
    candidates = [GLOBAL_INSTRUCTIONS] if GLOBAL_INSTRUCTIONS else [
        os.path.expanduser("~/.config/pi5-agent/AGENTS.md"),
        "/etc/my-pi5-setup/AGENTS.md",
    ]
    for path in candidates:
        if not path or not os.path.isfile(path):
            continue
        text, truncated = _read_instructions(path, GLOBAL_MD_MAX)
        if text:
            return path, text, truncated
    return None, "", False


def _plain(messages, timeout=None):
    """A completion with no tools, so a tool-parsing bug cannot mask a model
    that is simply not generating.

    The token budget is generous on purpose. A reasoning model spends tokens
    thinking before it answers, and a tight cap truncates it mid-thought - the
    reply then comes back with empty content and looks like a dead model.
    """
    payload = {"messages": messages, "temperature": 0.2, "max_tokens": 1024,
               "model": resolve_model()}
    if not SHOW_THINKING:
        # "think" is Ollama-native; OpenAI-compatible endpoints ignore it.
        # Set "reasoning_effort": "none" to suppress narration on those endpoints.
        payload["think"] = False
        payload["reasoning_effort"] = "none"
    data = post("/chat/completions", payload, timeout=timeout)
    msg = data["choices"][0]["message"]
    if msg.get("content"):
        msg["content"] = strip_thinking(msg["content"])
    return data


def selftest():
    """Four stages, in dependency order. Each one prints what it saw, so a
    failure says which layer broke rather than just 'it did not work'."""
    print(f"{BOLD}1. endpoint{RST}")
    print(f"   {BASE_URL}")
    model = loaded_model()
    if not model:
        print(f"   {RED}FAIL{RST} no model loaded")
        print("\n   ollama list    then    ollama pull qwen3.5:4b-q4_K_M")
        return 1
    print(f"   {GRN}ok{RST}  reachable")

    print(f"\n{BOLD}2. model{RST}")
    print(f"   {GRN}ok{RST}  {model}")

    print(f"\n{BOLD}3. inference{RST}")
    print(f"   {DIM}asking: 'In one short sentence, what is a Raspberry Pi?'{RST}")
    print(f"   {DIM}first run also loads the weights; allow a few minutes{RST}", flush=True)
    started = time.time()
    try:
        data = _plain([{"role": "user",
                        "content": "In one short sentence, what is a Raspberry Pi?"}])
    except SystemExit:
        raise
    elapsed = time.time() - started
    reply = data["choices"][0]["message"]
    answer = (reply.get("content") or "").strip()
    if not answer:
        # Some servers put a reasoning model's output in its own field and
        # leave content empty. That is a working model, reported badly.
        reasoning = (reply.get("reasoning_content") or reply.get("reasoning") or "").strip()
        finish = data["choices"][0].get("finish_reason", "")
        if reasoning:
            print(f"   {YEL}--{RST}  content was empty but the model did reason:")
            print(DIM + "   " + reasoning[:200] + RST)
            answer = reasoning
        else:
            print(f"   {RED}FAIL{RST} the model returned nothing"
                  + (f" (finish_reason: {finish})" if finish else ""))
            if finish == "length":
                print("   It ran out of tokens before answering - raise max_tokens.")
            else:
                print("   Try it directly:  ollama run " + resolve_model())
            return 1
    print(f"   {GRN}ok{RST}  {answer[:200]}")

    # tok/s is the number that tells you whether this is usable day to day.
    tokens = (data.get("usage") or {}).get("completion_tokens")
    if tokens and elapsed > 0:
        rate = tokens / elapsed
        if tokens >= 80:
            verdict = ("comfortable" if rate >= 5 else
                       "usable but slow" if rate >= 2 else
                       "painful - consider a smaller model")
            print(f"   {DIM}{tokens} tokens in {elapsed:.1f}s = {rate:.1f} tok/s ({verdict}){RST}")
        else:
            # Below this, elapsed time is mostly prompt processing and - on a
            # cold start - loading the weights from the SSD. Dividing that fixed
            # cost by a handful of tokens reported the same healthy setup as
            # "1.3 tok/s (painful)" cold and "3.5 tok/s" warm.
            print(f"   {DIM}{tokens} tokens in {elapsed:.1f}s - too short to measure"
                  f" a rate{RST}")
            print(f"   {DIM}most of that is prompt processing, plus loading the"
                  f" model on a cold start, not generation{RST}")
    else:
        print(f"   {DIM}{elapsed:.1f}s to first complete answer{RST}")

    print(f"\n{BOLD}4. tool calling{RST}")
    specs = tool_specs(include_write=False)

    print(f"   {DIM}trying native tool_calls…{RST}")
    msg = chat([{"role": "system", "content": "You have tools. Use them rather than guessing."},
                {"role": "user", "content": "List the open issues in this repository."}],
               specs)
    calls = msg.get("tool_calls") or []
    if calls:
        names = ", ".join(c["function"]["name"] for c in calls)
        print(f"   {GRN}ok{RST}  native tool_calls: {names}")
        print(f"\n{GRN}{BOLD}Local AI is working.{RST} pi5-agent runs in native mode.")
        return 0

    print(f"   {YEL}--{RST}  no native tool_calls from this runtime")
    print(f"   {DIM}trying the text protocol instead…{RST}")

    # Use the same system prompt the real loop uses. A test with a thinner
    # prompt can fail while the thing it tests works, which is worse than
    # having no test at all.
    msg = chat([{"role": "system", "content": SYSTEM + "\n" + tools_as_text(specs)},
                {"role": "user", "content": "List the open issues in this repository."}],
               None)
    parsed = parse_text_call(msg.get("content") or "")
    if parsed and parsed[1] is not None:
        print(f"   {GRN}ok{RST}  text protocol: {parsed[0]}({parsed[1]})")
        print(f"\n{GRN}{BOLD}Local AI is working.{RST} pi5-agent will use the text")
        print("protocol automatically - AGENT_TOOL_MODE=auto probes and falls back.")
        return 0
    if parsed:
        print(f"   {YEL}--{RST}  called {parsed[0]} but the ARGS JSON was malformed")
        print("   Usable, but expect retries. A different model may do better.")
        return 1

    print(f"   {RED}FAIL{RST} neither protocol produced a tool call. It replied:")
    print(DIM + "   " + (msg.get("content") or "(empty)")[:300] + RST)
    print("\nInference works, so chat and opencode are fine. For the agent, try a")
    print("model trained for tool use:  ollama pull hermes3:3b")
    return 1


def dispatch(tools, name, args, turn, mode, seen=None):
    """Run one tool call and return its result string."""
    if args is None:
        return ("error: ARGS was not valid JSON. Reply with exactly:\n"
                'TOOL: <name>\nARGS: {"key": "value"}')
    fn = getattr(tools, name, None)
    if fn is None:
        return f"error: no such tool: {name}"
    shown = ", ".join(
        f"{k}={(v[:40] + '…') if isinstance(v, str) and len(v) > 40 else v!r}"
        for k, v in args.items())
    if seen is not None:
        sig = f"{name}:{json.dumps(args, sort_keys=True)}"
        seen[sig] = seen.get(sig, 0) + 1
        if seen[sig] >= 3:
            print(f"{DIM}  [{turn}] {name}(…) repeated{RST}")
            return (f"error: you have called {name} with these exact arguments "
                    f"{seen[sig]} times. The result will not change. Use a "
                    f"different tool, or give your final answer.")

    print(f"{DIM}  [{turn}] {name}({shown}){RST}")
    tools.tools_used += 1
    try:
        result = fn(**args)
    except TypeError as exc:
        return f"error: wrong arguments for {name}: {exc}"
    if len(result) > MAX_TOOL_CHARS:
        result = result[:MAX_TOOL_CHARS] + "\n...(truncated)"
    return result


def settle(tools):
    """Leave the checkout the way we found it, however the run ended.

    This has to run on every exit path, not just the tidy one. It lived inline
    at the end of agent_loop, which meant die() - a model timeout, an endpoint
    that went away - raised SystemExit straight past it, leaving an agent branch
    checked out with uncommitted edits in it. That is exactly the state that
    wedges the queue: every later cycle sees a dirty tree and skips every issue.
    So it is called from a finally, and again by the queue after each issue.
    """
    if not tools.branch:
        return
    default = tools.default_branch()
    # Already back on the default branch means an earlier settle() finished the
    # job. Anything dirty here belongs to the human, not to this run.
    if tools.current_branch() != tools.branch:
        return

    # Committing on the agent branch keeps the attempt reviewable and hands the
    # default branch back clean.
    dirty = tools._git("status", "--porcelain")
    if dirty and not dirty.startswith("error"):
        warn("run ended with uncommitted changes; committing them on the branch")
        out = tools.git_commit(
            "wip: unfinished agent run\n\n"
            "The run stopped before committing. Kept so the attempt is "
            "reviewable; no pull request was opened.")
        if out.startswith(("error", "refused")):
            # Only reached when the secret scan refuses, or git fails.
            # Discarding the edits loses the attempt; leaving them wedges every
            # later run. The branch still records that it happened.
            warn(f"could not commit: {out.splitlines()[0]}")
            warn("discarding the changes so the queue is not left wedged")
            tools._git("reset", "--hard")
            tools._git("clean", "-fd")

    if tools.current_branch() != default:
        print(f"\n{BOLD}Review it:{RST}")
        print(f"  git -C {tools.workdir} diff {default}...{tools.branch}")
        print(f"  gh pr view --web")
        print(f"\nNothing was merged or closed. That is your call.")
        tools._git("switch", default)
        print(f"{DIM}  back on {default}; to inspect:  git switch {tools.branch}{RST}")


def agent_loop(prompt, tools, include_write):
    try:
        system = SYSTEM
        # Machine-level first, repo second: where they disagree, the nearer
        # file is the one the model reads last and follows.
        for label, (name, extra, truncated), cap in (
                ("Machine instructions", global_instructions(), GLOBAL_MD_MAX),
                ("Project instructions", repo_instructions(tools.workdir), AGENTS_MD_MAX)):
            if not extra:
                continue
            system += f"\n\n--- {label} from {name} ---\n{extra}"
            note = f"{DIM}  using {name}"
            note += f" (truncated to {cap} chars){RST}" if truncated else RST
            print(note)

        specs = tool_specs(include_write)
        mode = TOOL_MODE if TOOL_MODE in ("native", "text") else "auto"

        if mode == "text":
            system += "\n" + tools_as_text(specs)

        messages = [{"role": "system", "content": system},
                    {"role": "user", "content": prompt}]
        used_a_tool = False
        nudges = 0
        # Small models get stuck re-reading the same file. The turn limit bounds it,
        # but 20 identical calls is half an hour of this board achieving nothing.
        seen_calls = {}

        for turn in range(1, MAX_TURNS + 1):
            msg = chat(messages, specs if mode != "text" else None)
            calls = msg.get("tool_calls") or []
            content = msg.get("content") or ""

            # A model whose runtime cannot emit tool_calls is not broken, it just
            # needs asking differently. Probe once, then commit to the protocol
            # that works for the rest of the run.
            if mode == "auto":
                if calls:
                    mode = "native"
                else:
                    mode = "text"
                    print(f"{DIM}  no native tool_calls; using the text protocol{RST}")
                    messages[0]["content"] = system + "\n" + tools_as_text(specs)
                    # If it already answered in the text format, keep that call
                    # rather than paying for another round - inference is slow here.
                    if not parse_text_call(content):
                        continue

            if max(seen_calls.values(), default=0) >= 5:
                warn("the model is repeating the same call; stopping early")
                break

            if mode == "native" and calls:
                used_a_tool = True
                messages.append(msg)
                for call in calls:
                    fname = call["function"]["name"]
                    try:
                        fargs = json.loads(call["function"].get("arguments") or "{}")
                    except json.JSONDecodeError:
                        fargs = None
                    messages.append({
                        "role": "tool",
                        "tool_call_id": call.get("id", fname),
                        "content": dispatch(tools, fname, fargs, turn, mode, seen_calls),
                    })
                if tools.gave_up:
                    break
                continue

            if mode == "text":
                parsed = parse_text_call(content)
                if parsed:
                    used_a_tool = True
                    fname, fargs = parsed
                    result = dispatch(tools, fname, fargs, turn, mode, seen_calls)
                    messages.append({"role": "assistant", "content": content})
                    # No role:"tool" in this mode - the result comes back as user text.
                    messages.append({"role": "user", "content": f"TOOL RESULT:\n{result}"})
                    if tools.gave_up:
                        break
                    continue

            # A small model often answers "I will add that line" without calling
            # anything. Treating that as a finished job is how an issue gets marked
            # failed with no branch and no explanation.
            if include_write and (not used_a_tool or not content.strip()) and nudges < 2:
                nudges += 1
                print(f"{DIM}  no tool used yet; asking it to act (nudge {nudges}/2){RST}")
                messages.append({"role": "assistant", "content": content})
                messages.append({"role": "user", "content":
                    "You have not finished. Do not describe what you would do - do "
                    "it. Reply with a single tool call now. To add a line to the "
                    "end of a file use append_file; to change part of one use "
                    "replace_in_file. Do not use write_file on a large file."})
                continue

            print("\n" + (content or "(no answer)").strip())
            break
        else:
            warn(f"gave up after {MAX_TURNS} turns")

        if tools.gave_up:
            warn(f"the model stopped: {tools.gave_up}")

    finally:
        # Every exit path, including die()'s SystemExit and a Ctrl-C.
        settle(tools)
    return 0


LABEL = os.environ.get("AGENT_LABEL", "agent:queued")
LABEL_DONE = os.environ.get("AGENT_LABEL_DONE", "agent:done")
LABEL_FAILED = os.environ.get("AGENT_LABEL_FAILED", "agent:failed")
# A second label hands the issue to opencode instead. Same model, but a more
# developed harness - notably patch-based edits, where write_file here replaces
# whole files. On an 8K context that is the difference between a small file and
# a real one.
LABEL_OPENCODE = os.environ.get("AGENT_LABEL_OPENCODE", "agent:opencode")
# When the built-in loop produces no PR, try opencode before giving up. Its
# failure modes are genuinely different - patch edits rather than whole-file
# rewrites - so this is a second approach, not a retry of the same one.
ESCALATE = os.environ.get("AGENT_ESCALATE", "1") == "1"


def work_with_opencode(tools, num, title, body):
    """Delegate one issue to the opencode CLI, inside our own guard rails.

    We branch before handing over and commit and open the PR afterwards, so the
    containment is unchanged: opencode edits files, but it never chooses the
    branch, never touches the default branch, and never opens the PR itself.
    """
    if not shutil.which("opencode"):
        return "opencode is not installed (make app APP=opencode)"

    out = tools.git_branch(f"issue-{num}")
    if out.startswith("error") or out.startswith("refused"):
        return out

    # opencode reads the project's AGENTS.md itself, but not our machine-level
    # file - so pass its contents in the prompt. Same rules, both harnesses.
    gname, gtext, _ = global_instructions()
    machine = f"\n\nMachine instructions (from {gname}):\n{gtext}" if gtext else ""

    prompt = (f"Work GitHub issue #{num}: {title}\n\n{body}\n\n"
              "Make the smallest change that addresses this. Do not commit or "
              "push - that is handled for you." + machine)

    print(f"{DIM}  handing #{num} to opencode…{RST}")
    try:
        proc = subprocess.run(
            ["opencode", "run", "--auto", "--dir", tools.workdir, prompt],
            capture_output=True, text=True, timeout=3600)
    except subprocess.TimeoutExpired:
        return "opencode timed out after an hour"
    tail = ((proc.stdout or "") + (proc.stderr or "")).strip().splitlines()[-15:]
    print(DIM + "\n".join("  " + t for t in tail) + RST)

    changed = tools._git("status", "--porcelain")
    if not changed or changed.startswith("error"):
        return "opencode made no changes"

    # opencode edits files itself, so the write-time guard cannot apply. Check
    # what it touched before committing any of it.
    touched = [ln[3:].strip() for ln in changed.splitlines() if len(ln) > 3]
    # git_commit stages tools.touched, which the agent's own write tools fill
    # in. opencode edits files itself, so record what it changed here or the
    # commit has nothing to stage and refuses.
    tools.touched.update(touched)
    blocked = [f for f in touched if tools.is_protected(f)]
    if blocked:
        tools._git("checkout", "--", ".")
        return ("opencode modified this agent's own code (" +
                ", ".join(blocked[:5]) + "); changes reverted, nothing committed")

    # "Refs", not "Closes": a closing keyword in a commit message closes the
    # issue on merge just as one in the PR body does, and nothing here has
    # checked that the diff answers the issue.
    commit = tools.git_commit(f"fix: {title}\n\nRefs #{num}. Written by opencode "
                              f"on the Pi, unreviewed.")
    if commit.startswith("error"):
        return commit
    # No issue link here: gh_pr_create adds exactly one, in whichever form
    # AGENT_PR_CLOSES selects. Writing "Refs #N" at this level produced a body
    # that said both "Refs #5." and "Closes #5".
    stat = tools._git("diff", "--stat", f"{tools.default_branch()}...HEAD")
    detail = f"\n\n```\n{stat.strip()}\n```" if stat and not stat.startswith("error") else ""
    return tools.gh_pr_create(
        f"{title}",
        f"Edited via the opencode harness, after the built-in loop produced "
        f"no pull request.{detail}")



def queue(args):
    """Work every open issue carrying the trigger label.

    Idempotence comes from the labels and from the branch: an issue whose
    agent/issue-N branch already exists is treated as already attempted, so a
    rerun after a crash does not duplicate work or reopen the same PR.
    """
    probe = Tools(args.workdir, args.repo, False, True)

    listing = probe._gh("issue", "list", "--state", "open", "--label", LABEL,
                        "--json", "number,title,body,labels", "--limit", "20")
    if listing.startswith("error"):
        die(listing)
    try:
        issues = json.loads(listing or "[]")
    except json.JSONDecodeError:
        die(f"could not parse the issue list: {listing[:200]}")

    if not issues:
        say(f"no open issues labelled '{LABEL}'")
        return 0

    say(f"{len(issues)} issue(s) labelled '{LABEL}'")
    if not args.allow_write:
        for it in issues:
            print(f"   #{it['number']}  {it['title']}")
        warn("read-only: add --allow-write to actually work them")
        return 0

    default = probe.default_branch()
    worked = failed = skipped = 0

    for it in issues:
        num, title = it["number"], it["title"]
        branch = f"{BRANCH_PREFIX}issue-{num}"

        existing = probe._git("ls-remote", "--heads", "origin", branch)
        if existing and not existing.startswith("error"):
            print(f"\n{DIM}skip #{num}: {branch} already exists on origin{RST}")
            skipped += 1
            continue

        print(f"\n{BOLD}=== #{num}  {title}{RST}")
        started = time.monotonic()

        # Each issue starts from a clean default branch, or its diff would
        # include the previous issue's work.
        probe._git("switch", default)
        dirty = probe._git("status", "--porcelain")
        if dirty and not dirty.startswith("error"):
            warn(f"working tree dirty before #{num}; skipping")
            skipped += 1
            continue

        tools = Tools(args.workdir, args.repo, True, True)
        tools.issue_number = num
        labels = {lab.get("name", "") for lab in (it.get("labels") or [])}

        try:
            if LABEL_OPENCODE in labels:
                result = work_with_opencode(tools, num, title, it.get("body") or "")
                if result.startswith(("error", "refused", "opencode")):
                    warn(f"#{num}: {result}")
            else:
                prompt = (f"Work issue #{num}. Read it with gh_issue_view first, then "
                          f"find the relevant code before changing anything. Use "
                          f"branch name issue-{num}.")
                agent_loop(prompt, tools, True)
        except KeyboardInterrupt:
            # Interrupted is not failed. Leave the label alone so a rerun picks
            # this issue up again rather than needing it relabelled by hand.
            print()
            warn(f"interrupted during #{num}; its label is unchanged")
            probe._git("switch", default)
            return 130
        except SystemExit:
            raise
        except Exception as exc:                      # noqa: BLE001
            warn(f"#{num} raised: {exc}")

        # opencode edits files itself and can time out mid-change, so its
        # leftovers need the same treatment as the built-in loop's.
        settle(tools)

        # Kept before the escalation replaces `tools`, since the reason has to
        # outlive the object that recorded it.
        gave_up = tools.gave_up
        turns = tools.tools_used

        # Second approach before conceding, if the first one produced nothing.
        #
        # Not when the model said why it stopped. Escalation exists for the
        # harness's limits - opencode edits by patch where write_file rewrites
        # whole files - and it runs the same local model, so it cannot know
        # anything this loop did not. Retrying a stated "I have no way to find
        # this out" costs up to an hour of the board and reaches the same wall.
        escalated = False
        if (not tools.pr_url and not gave_up and ESCALATE
                and LABEL_OPENCODE not in labels
                and shutil.which("opencode")):
            warn(f"#{num}: the built-in loop produced no PR, trying opencode")
            probe._git("switch", default)
            probe._git("reset", "--hard")
            tools = Tools(args.workdir, args.repo, True, True)
            tools.issue_number = num
            escalated = True
            try:
                result = work_with_opencode(tools, num, title, it.get("body") or "")
                if not tools.pr_url:
                    warn(f"#{num}: opencode also produced no PR ({result})")
            except KeyboardInterrupt:
                print()
                warn(f"interrupted during #{num}; its label is unchanged")
                probe._git("switch", default)
                return 130
            except Exception as exc:                  # noqa: BLE001
                warn(f"#{num}: opencode raised: {exc}")
            settle(tools)

        if tools.pr_url:
            tools._gh("issue", "edit", str(num),
                      "--add-label", LABEL_DONE, "--remove-label", LABEL)
            via = " via opencode, after the built-in loop failed" if escalated else ""
            tools._gh("issue", "comment", str(num),
                      "--body", f"Draft PR opened by the local agent{via}: "
                                f"{tools.pr_url}\n\n"
                                f"Model output is unreviewed. Please read the diff. "
                                f"Merging it closes this issue "
                                f"(AGENT_PR_CLOSES=0 to change that).")
            print(f"{GRN}#{num} -> {tools.pr_url}{RST}")
            worked += 1
        else:
            tools._gh("issue", "edit", str(num),
                      "--add-label", LABEL_FAILED, "--remove-label", LABEL)
            if gave_up:
                # Its own words, not our guess at them.
                body = (f"The local agent stopped and said why:\n\n> {gave_up}\n\n"
                        "No pull request was opened, and opencode was not tried: "
                        "it runs the same model, so a second attempt would hit the "
                        "same wall. Answer the question above in the issue and "
                        "re-label `agent:queued`, or add `agent:opencode` to send "
                        "it to the wider harness anyway.")
            else:
                # Say what happened. This used to infer the reason from
                # whether a branch existed, and told issue #9 that the model
                # "never called a tool" after it had called four.
                if not tools.tools_used:
                    reason = "It answered in prose without ever calling a tool"
                elif not tools.branch:
                    reason = (f"It called {tools.tools_used} tool(s) but never "
                              "created a branch, so nothing was written")
                else:
                    reason = (f"It called {tools.tools_used} tool(s) and worked on "
                              "a branch, but opened no pull request")
                if escalated:
                    reason += ", and opencode did not manage it either"
                elif ESCALATE and LABEL_OPENCODE not in labels:
                    reason += ("; opencode was not tried because it is not on "
                               "this service's PATH")
                body = (f"The local agent did not finish this one. {reason}. "
                        "No pull request was opened.\n\n"
                        "Re-label `agent:queued` to try again.")
            tools._gh("issue", "comment", str(num), "--body", body)
            warn(f"#{num}: {gave_up}" if gave_up else f"#{num} produced no PR")
            failed += 1

        # One greppable line per issue, so "did the last change help" is a table
        # rather than an argument. The journal is the record; this is the row.
        outcome = ("pr" if tools.pr_url else
                   "gave-up" if gave_up else
                   "no-pr")
        print(f"{BOLD}--- #{num} {outcome} "
              f"turns={turns} "
              f"elapsed={time.monotonic() - started:.0f}s"
              f"{' escalated' if escalated else ''}{RST}")

    probe._git("switch", default)
    print(f"\n{BOLD}{worked} PR(s) opened, {failed} failed, {skipped} skipped{RST}")
    print("Nothing was merged or closed - review the pull requests.")
    return 0


def main():
    ap = argparse.ArgumentParser(description="Work GitHub issues with the local model.")
    ap.add_argument("prompt", nargs="?")
    ap.add_argument("--selftest", action="store_true")
    ap.add_argument("--issue", type=int, help="work this issue end to end")
    ap.add_argument("--repo", help="owner/name; defaults to the checkout's remote")
    ap.add_argument("-C", "--workdir", default=".")
    ap.add_argument("--allow-write", action="store_true",
                    help="permit branching, editing, committing and opening a PR")
    ap.add_argument("--yes", action="store_true", help="skip confirmation for PRs and comments")
    ap.add_argument("--force", action="store_true", help="proceed even with a dirty tree")
    ap.add_argument("--queue", action="store_true",
                    help=f"work every open issue labelled '{LABEL}'")
    args = ap.parse_args()

    if args.selftest:
        sys.exit(selftest())
    if args.queue:
        sys.exit(queue(args))
    if not args.prompt and args.issue is None:
        ap.error("give a prompt, --issue N, --queue, or --selftest")

    tools = Tools(args.workdir, args.repo, args.allow_write, args.yes)
    tools.issue_number = args.issue

    if args.allow_write:
        # Mixing the model's edits into your work in progress makes the diff
        # useless as a review artefact.
        dirty = tools._git("status", "--porcelain")
        if dirty and not dirty.startswith("error") and not args.force:
            die("the working tree has uncommitted changes.\n"
                "  Commit or stash them first, so the review diff is only the agent's work.\n"
                "  Or pass --force.")

    if args.issue is not None:
        prompt = (f"Work issue #{args.issue}. Start by reading it with gh_issue_view, "
                  f"then find the relevant code before changing anything. "
                  f"Use branch name issue-{args.issue}.")
        if args.prompt:
            prompt += f"\n\nExtra instruction from the user: {args.prompt}"
        if not args.allow_write:
            warn("read-only: add --allow-write to let it branch, edit and open a PR")
    else:
        prompt = args.prompt

    sys.exit(agent_loop(prompt, tools, args.allow_write))


if __name__ == "__main__":
    main()
