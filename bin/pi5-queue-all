#!/usr/bin/env bash
# Work the agent:queued issues in every repo, then report what happened.
#
# Run by pi5-queue.timer. Kept separate from pi5-agent so the timer can cover
# several checkouts, and so the notification logic stays out of the agent.
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
AGENT="${AGENT_BIN:-$HERE/pi5-agent}"
GITHUB_DIR="${GITHUB_DIR:-$HOME/GitHub}"
# Optional narrowing. Empty means every git checkout under GITHUB_DIR.
QUEUE_REPOS="${QUEUE_REPOS:-}"
# 1 = search GitHub for labelled issues across your repos and clone any that
# are not here yet. Off by default: without it this only ever touches repos you
# have already chosen to put on this machine.
QUEUE_DISCOVER="${QUEUE_DISCOVER:-0}"
QUEUE_OWNER="${QUEUE_OWNER:-}"
# Repo topic that opts a repository in. Declared on GitHub rather than in a file
# here, so a repo joins or leaves by editing its topics. Empty means every repo
# the owner has, which is broader than most people want left running.
QUEUE_TOPIC="${QUEUE_TOPIC:-}"

log() { printf '[pi5-queue] %s\n' "$*"; }

notify() {
	# Only if the Telegram bridge is configured. systemd reads the env file as
	# root before dropping privileges, so the token is readable here without
	# loosening its 0600.
	[ -n "${TELEGRAM_TOKEN:-}" ] && [ -n "${TELEGRAM_ALLOWED_IDS:-}" ] || return 0
	local id
	for id in ${TELEGRAM_ALLOWED_IDS//,/ }; do
		curl -fsS --max-time 15 -X POST \
			"https://api.telegram.org/bot${TELEGRAM_TOKEN}/sendMessage" \
			-d "chat_id=${id}" --data-urlencode "text=$1" >/dev/null 2>&1 || true
	done
}

local_repos() {
	local d
	for d in "$GITHUB_DIR"/*/; do
		[ -d "$d/.git" ] && basename "$d"
	done
}

# Ask GitHub which repos have a labelled issue, and clone the ones that are not
# here. Without this an issue labelled in an uncloned repo is simply invisible.
discover_and_clone() {
	local owner="$QUEUE_OWNER"
	if [ -z "$owner" ]; then
		owner="$(gh api user --jq .login 2>/dev/null || true)"
	fi
	[ -n "$owner" ] || { log "cannot determine the GitHub owner; skipping discovery"; return 0; }

	local found
	found="$(gh search issues --owner "$owner" --label "${AGENT_LABEL:-agent:queued}" \
		--state open --limit 50 --json repository \
		--jq '.[].repository.name' 2>/dev/null | sort -u)"
	if [ -z "$found" ]; then
		return 0
	fi

	# A topic is the opt-in: it lives on GitHub, so a repo joins or leaves
	# without touching this machine, and it is a query rather than a judgement
	# call - no model involved in deciding what gets cloned.
	if [ -n "$QUEUE_TOPIC" ]; then
		local allowed
		allowed="$(gh search repos --owner "$owner" --topic "$QUEUE_TOPIC" \
			--limit 100 --json name --jq '.[].name' 2>/dev/null | sort -u)"
		if [ -z "$allowed" ]; then
			log "no repos carry the '$QUEUE_TOPIC' topic; nothing to discover"
			return 0
		fi
		found="$(printf '%s\n' $found | grep -Fxf <(printf '%s\n' $allowed) || true)"
		[ -n "$found" ] || return 0
	fi

	local name
	for name in $found; do
		# An allowlist still wins: discovery finds repos, it does not widen scope.
		if [ -n "$QUEUE_REPOS" ] && ! printf '%s\n' ${QUEUE_REPOS//,/ } | grep -qx "$name"; then
			log "discovery: skipping $name, not in QUEUE_REPOS"
			continue
		fi
		if [ -d "$GITHUB_DIR/$name/.git" ]; then
			continue
		fi
		log "cloning $owner/$name (has queued issues, not on this machine)"
		mkdir -p "$GITHUB_DIR"
		if gh repo clone "$owner/$name" "$GITHUB_DIR/$name" -- --depth 50 >/dev/null 2>&1; then
			log "cloned $name"
		else
			log "could not clone $owner/$name"
		fi
	done
}

repos() {
	[ "$QUEUE_DISCOVER" = "1" ] && discover_and_clone
	if [ -n "$QUEUE_REPOS" ]; then
		printf '%s\n' ${QUEUE_REPOS//,/ }
		return
	fi
	local_repos
}

worked_total=0
summary=""

for name in $(repos); do
	dir="$GITHUB_DIR/$name"
	[ -d "$dir/.git" ] || { log "skip $name: not a checkout"; continue; }

	# Cheap check first: most cycles have nothing to do, and starting the model
	# for an empty queue wastes minutes of CPU on a board that has none spare.
	pending="$(cd "$dir" && gh issue list --state open \
		--label "${AGENT_LABEL:-agent:queued}" --json number --jq 'length' 2>/dev/null || echo 0)"
	if [ "${pending:-0}" = "0" ]; then
		continue
	fi

	log "$name: $pending issue(s) queued"
	# Branch off current work, not whatever was here last time.
	( cd "$dir" && git fetch --quiet origin 2>/dev/null \
		&& git merge --ff-only --quiet 2>/dev/null ) || true
	out="$("$AGENT" --queue --allow-write -C "$dir" 2>&1)"
	printf '%s\n' "$out"

	# Report only the PR links; the rest is in the journal.
	prs="$(printf '%s\n' "$out" | grep -oE 'https://github\.com/[^ ]+/pull/[0-9]+' | sort -u)"
	if [ -n "$prs" ]; then
		worked_total=$((worked_total + $(printf '%s\n' "$prs" | grep -c .)))
		summary="${summary}${name}:
$prs
"
	fi
done

if [ "$worked_total" -gt 0 ]; then
	log "$worked_total draft PR(s) opened"
	notify "The Pi opened $worked_total draft PR(s):

$summary
Nothing was merged or closed."
fi
