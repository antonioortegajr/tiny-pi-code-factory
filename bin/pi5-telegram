#!/usr/bin/env python3
"""Tell the Pi a repo has work waiting. Stdlib only, no pip deps.

Deliberately NOT a chat bot. There is no free-form path to the model: the only
thing you can say is "this repo has issues labelled agent:queued", and the only
thing it does is work them into draft PRs. Four commands, nothing else parsed.

  /repos             which repos it can see
  /work <repo>       work the agent:queued issues in that repo
  /status            model server health
  /help              the above

Plain phrasing is matched too - "Doom check for new issues in my-pi5-setup"
finds the repo name and runs the queue - but by string matching here, not by
asking the model. Nothing a message contains is ever sent to it as a prompt, so
this stays a fixed set of reviewable workflows however it is phrased.

Long polling, so the Pi needs no public IP, no webhook and no TLS certificate -
it dials out.

SECURITY: a bot token is a URL anyone can POST to. Without an allowlist any
stranger who finds the bot could drive it, so this refuses to start unless
TELEGRAM_ALLOWED_IDS is set, and ignores every message from anyone else. Repos
are limited to checkouts under GITHUB_DIR, so a message cannot name an
arbitrary path.

TELEGRAM_PASSPHRASE adds a second lock, checked after the allowlist. Note what
it does and does not buy: against a stranger it is redundant, since they never
get past the chat id. It earns its place if your own Telegram account is
compromised or your unlocked phone is borrowed - the allowlist checks who you
are, the passphrase checks what you know. It is not a strong secret either way,
since it sits in plaintext chat history on both devices and on Telegram's
servers.
"""

import hmac
import json
import os
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

TOKEN = os.environ.get("TELEGRAM_TOKEN", "").strip()
ALLOWED = {i.strip() for i in os.environ.get("TELEGRAM_ALLOWED_IDS", "").split(",") if i.strip()}
ALLOW_WRITE = os.environ.get("TELEGRAM_ALLOW_WRITE", "0") == "1"
# Optional second lock. Checked after the allowlist, so anyone who reaches it is
# already a known chat id - which is why a mismatch here gets an answer while an
# unlisted chat gets silence.
PASSPHRASE = os.environ.get("TELEGRAM_PASSPHRASE", "").strip()
GITHUB_DIR = os.environ.get("GITHUB_DIR", os.path.expanduser("~/GitHub"))
# Optional narrowing: a comma-separated list of repo names. Empty means any
# checkout under GITHUB_DIR.
REPO_ALLOWLIST = {r.strip() for r in os.environ.get("TELEGRAM_REPOS", "").split(",") if r.strip()}
AGENT = os.environ.get("TELEGRAM_AGENT_BIN",
                       os.path.join(os.path.dirname(os.path.abspath(__file__)), "pi5-agent"))
POLL_TIMEOUT = int(os.environ.get("TELEGRAM_POLL_TIMEOUT", "30"))
API = f"https://api.telegram.org/bot{TOKEN}"

# Telegram rejects messages over 4096 characters.
MAX_MSG = 3900


def log(msg):
    print(f"[pi5-telegram] {msg}", flush=True)


def api(method, **params):
    url = f"{API}/{method}"
    data = urllib.parse.urlencode(params).encode()
    try:
        with urllib.request.urlopen(urllib.request.Request(url, data=data),
                                    timeout=POLL_TIMEOUT + 15) as resp:
            return json.load(resp)
    except urllib.error.HTTPError as exc:
        log(f"{method} failed: {exc.code} {exc.read().decode()[:200]}")
    except urllib.error.URLError as exc:
        log(f"{method} unreachable: {exc.reason}")
    except TimeoutError:
        pass
    return None


def send(chat_id, text):
    if len(text) > MAX_MSG:
        text = text[:MAX_MSG] + "\n…(truncated)"
    api("sendMessage", chat_id=chat_id, text=text or "(no output)")


def run_agent(args, timeout=1800):
    """The agent is a separate process, so a crash or a hang in it cannot take
    the bot down with it."""
    try:
        proc = subprocess.run([AGENT, *args], cwd=GITHUB_DIR, capture_output=True,
                              text=True, timeout=timeout)
    except FileNotFoundError:
        return f"pi5-agent not found at {AGENT}"
    except subprocess.TimeoutExpired:
        return "timed out - the model is slow on this hardware, try a smaller task"
    out = (proc.stdout or "") + (proc.stderr or "")
    return out.strip() or "(no output)"


HELP = """I work GitHub issues on the Pi. I do not chat.

/work <repo>    work the issues labelled agent:queued there
/repos          repos I can see
/status         is the local model up
/help           this

Naming a repo in plain words works too:
  "check for new github issues in my-pi5-setup"

Label an issue agent:queued, then tell me the repo.
Draft PRs only - nothing is merged or closed."""


def available_repos():
    """Checkouts under GITHUB_DIR, optionally narrowed by TELEGRAM_REPOS. A
    message can only ever name one of these, never an arbitrary path."""
    try:
        names = sorted(n for n in os.listdir(GITHUB_DIR)
                       if os.path.isdir(os.path.join(GITHUB_DIR, n, ".git")))
    except OSError:
        return []
    if REPO_ALLOWLIST:
        names = [n for n in names if n in REPO_ALLOWLIST]
    return names


def check_passphrase(text):
    """Returns the message with the passphrase stripped, or None if it is wrong.

    Case-insensitive: a phone will capitalise the first word of a message, so
    "doom" and "Doom" have to be the same thing. This costs almost nothing given
    the phrase is a speed bump rather than a secret.
    """
    if not PASSPHRASE:
        return text
    stripped = text.strip()
    prefix = stripped[:len(PASSPHRASE)]
    if not hmac.compare_digest(prefix.lower(), PASSPHRASE.lower()):
        return None
    return stripped[len(PASSPHRASE):].strip(" ,.:;-")


def handle(text, chat_id):
    cmd = text.strip()
    parts = cmd.split()
    verb = parts[0].lower() if parts else ""

    if verb in ("/start", "/help"):
        return HELP

    if verb == "/repos":
        repos = available_repos()
        if not repos:
            return f"No git checkouts found under {GITHUB_DIR}."
        return "I can work:\n" + "\n".join(f"  {r}" for r in repos)

    if verb == "/status":
        out = run_agent(["--selftest"], timeout=300)
        return "\n".join(out.splitlines()[-12:])

    if verb == "/work":
        repos = available_repos()
        if len(parts) < 2:
            return "Which repo? Try /repos to see them, then /work <repo>."
        name = parts[1]
        if name not in repos:
            return (f"I cannot see a repo called {name!r}.\n"
                    f"Available: {', '.join(repos) or '(none)'}")

        workdir = os.path.join(GITHUB_DIR, name)
        if not ALLOW_WRITE:
            listing = run_agent(["--queue", "-C", workdir], timeout=300)
            return ("Writes are disabled, so here is what I would work:\n\n"
                    + listing +
                    "\n\nSet TELEGRAM_ALLOW_WRITE=1 and restart to let me do it.")

        send(chat_id, f"Working queued issues in {name}. This takes a while on a Pi…")
        return run_agent(["--queue", "--allow-write", "-C", workdir])

    # Plain phrasing, matched deterministically. Naming a repo is taken as
    # "work it" - the only action there is anyway. Nothing here reaches the
    # model, so this is a friendlier parser, not a loosened boundary.
    lowered = cmd.lower()

    if any(w in lowered for w in ("status", "health", "alive", "up?")):
        return handle("/status", chat_id)

    if any(w in lowered for w in ("repos", "repositories", "what can you")):
        return handle("/repos", chat_id)

    for name in available_repos():
        if name.lower() in lowered:
            return handle(f"/work {name}", chat_id)

    repos = available_repos()
    return ("I did not spot a repo I know in that.\n"
            f"I can work: {', '.join(repos) or '(none)'}\n\n" + HELP)


def main():
    if not TOKEN:
        sys.exit("TELEGRAM_TOKEN is not set. Put it in settings.local.env.")
    if not ALLOWED:
        sys.exit("TELEGRAM_ALLOWED_IDS is empty. Refusing to start: without it, "
                 "anyone who finds this bot could drive it.\n"
                 "Message the bot, then read the chat id from its logs, or use "
                 "@userinfobot to find yours.")

    me = api("getMe")
    if not me or not me.get("ok"):
        sys.exit("could not reach Telegram - check the token and the network")
    log(f"connected as @{me['result'].get('username')}")
    log(f"allowed chat ids: {', '.join(sorted(ALLOWED))}")
    log(f"writes: {'enabled' if ALLOW_WRITE else 'disabled (preview only)'}")
    log(f"repos: {', '.join(available_repos()) or f'none found under {GITHUB_DIR}'}")
    log(f"passphrase: {'required' if PASSPHRASE else 'not set'}")

    offset = None
    while True:
        params = {"timeout": POLL_TIMEOUT}
        if offset is not None:
            params["offset"] = offset
        updates = api("getUpdates", **params)
        if not updates or not updates.get("ok"):
            time.sleep(5)
            continue

        for upd in updates["result"]:
            offset = upd["update_id"] + 1
            msg = upd.get("message") or upd.get("edited_message")
            if not msg:
                continue
            chat_id = str(msg.get("chat", {}).get("id", ""))
            text = msg.get("text", "")
            if not text:
                continue

            if chat_id not in ALLOWED:
                # Logged, not answered: replying confirms the bot is live.
                log(f"ignoring message from unlisted chat {chat_id}")
                continue

            body = check_passphrase(text)
            if body is None:
                # An allowlisted chat that got the phrase wrong is almost
                # certainly you mistyping, so say so rather than look broken.
                log(f"wrong passphrase from {chat_id}")
                send(chat_id, "I don't know you.")
                continue
            if not body:
                body = "/help"

            log(f"{chat_id}: {body[:80]}")
            try:
                send(chat_id, handle(body, chat_id))
            except Exception as exc:              # noqa: BLE001
                log(f"handler failed: {exc}")
                send(chat_id, f"Something broke handling that: {exc}")


if __name__ == "__main__":
    main()
